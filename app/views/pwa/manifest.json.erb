{
  "name": "<%= Setting.fetch(:site_name, 'HomeChat') %>",
  "short_name": "<%= Setting.fetch(:pwa_short_name, Setting.fetch(:site_name, 'HomeChat')) %>",
  "start_url": <%= raw root_path.to_json %>,
  "display": "<%= Setting.fetch(:pwa_display, 'standalone') %>",
  "theme_color": "<%= Setting.fetch(:pwa_theme_color, '#2563eb') %>",
  "background_color": "<%= Setting.fetch(:pwa_bg_color, '#ffffff') %>",
  "icons": [
    { "src": <%= raw asset_path("icon.png", skip_pipeline: true).to_json %>, "sizes": "192x192", "type": "image/png" },
    { "src": <%= raw asset_path("icon.png", skip_pipeline: true).to_json %>, "sizes": "512x512", "type": "image/png" },
    { "src": <%= raw asset_path("icon.svg", skip_pipeline: true).to_json %>, "sizes": "any", "type": "image/svg+xml" }
  ]
}
