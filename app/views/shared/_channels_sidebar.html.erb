<div class="sidebar-root">
  <!-- Header -->
  <div class="sidebar-header">
    <span class="sidebar-wordmark">
      <span class="sidebar-logo-mark" aria-hidden="true"></span>
      HomeChat
    </span>
    <button class="md:hidden sidebar-close-btn" data-action="click->sidebar#close" aria-label="Close sidebar">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="sidebar-command-hint">
    <kbd>Cmd</kbd>
    <span>+</span>
    <kbd>K</kbd>
    <span>Quick switch</span>
  </div>

  <!-- Scrollable body -->
  <div class="sidebar-scroll">

    <!-- Channels -->
    <div class="sidebar-section">
      <div class="sidebar-section-header">
        <span class="sidebar-section-label">Channels</span>
        <%= link_to new_channel_path,
            class: "sidebar-section-action",
            title: "New Channel",
            "aria-label": "New channel" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 5v14M5 12h14" />
          </svg>
        <% end %>
      </div>

      <div class="sidebar-items">
        <% @sidebar_my_channels.each do |channel| %>
          <% active = request.path == channel_path(channel) %>
          <%= link_to channel_path(channel),
              class: "sidebar-item #{active ? 'sidebar-item-active' : ''}",
              aria: { current: (active ? 'page' : nil) } do %>
            <span class="sidebar-item-icon">
              <% if channel.channel_type == 'private' %>
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
                </svg>
              <% else %>
                <span aria-hidden="true">#</span>
              <% end %>
            </span>
            <span class="sidebar-item-label flex items-center gap-1.5">
              <span><%= channel.name %></span>
              <% if E2eePolicy.required_for_channel?(channel) %>
                <%= e2ee_icon(class_name: 'w-3 h-3', tone_class: 'text-emerald-600', aria_hidden: true) %>
                <span class="sr-only">End-to-end encrypted</span>
              <% end %>
            </span>
            <% if @sidebar_unread_counts&.dig(channel.id).to_i > 0 %>
              <span class="unread-badge sidebar-unread-badge">
                <%= @sidebar_unread_counts[channel.id] > 99 ? '99+' : @sidebar_unread_counts[channel.id] %>
              </span>
            <% end %>
          <% end %>
        <% end %>

        <% if @sidebar_my_channels.empty? %>
          <div class="sidebar-empty-text">No channels joined</div>
        <% end %>

        <%= link_to channels_path, class: "sidebar-browse-link" do %>
          <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          Browse all channels
        <% end %>
      </div>
    </div>

    <!-- Direct Messages -->
    <div class="sidebar-section">
      <div class="sidebar-section-header">
        <span class="sidebar-section-label">Direct Messages</span>
        <%= link_to new_dm_path,
            class: "sidebar-section-action",
            title: "New DM",
            "aria-label": "New direct message" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 5v14M5 12h14" />
          </svg>
        <% end %>
      </div>

      <div class="sidebar-items">
        <% @sidebar_dm_channels.each do |channel| %>
          <% other_user = @sidebar_dm_other_users_by_channel_id&.[](channel.id) %>
          <% active = request.path == channel_path(channel) %>
          <%= link_to channel_path(channel),
              class: "sidebar-item #{active ? 'sidebar-item-active' : ''}",
              aria: { current: (active ? 'page' : nil) } do %>
            <span class="sidebar-item-icon relative">
              <%= avatar_for(other_user, size: 'h-5 w-5') %>
              <% if user_online?(other_user) %>
                <span class="absolute -bottom-0.5 -right-0.5 block h-2 w-2 rounded-full bg-green-500 status-online sidebar-dm-online-dot" aria-hidden="true"></span>
                <span class="sr-only">(online)</span>
              <% end %>
            </span>
            <span class="sidebar-item-label flex items-center gap-1.5">
              <span><%= other_user&.username || 'Unknown User' %></span>
              <% if E2eePolicy.required_for_channel?(channel) %>
                <%= e2ee_icon(class_name: 'w-3 h-3', tone_class: 'text-emerald-600', aria_hidden: true) %>
                <span class="sr-only">End-to-end encrypted</span>
              <% end %>
            </span>
            <% if @sidebar_unread_counts&.dig(channel.id).to_i > 0 %>
              <span class="unread-badge sidebar-unread-badge">
                <%= @sidebar_unread_counts[channel.id] > 99 ? '99+' : @sidebar_unread_counts[channel.id] %>
              </span>
            <% end %>
          <% end %>
        <% end %>

        <% if @sidebar_dm_channels.blank? %>
          <div class="sidebar-empty-text">No conversations yet</div>
        <% end %>
      </div>
    </div>

    <!-- Admin -->
    <% if current_user.admin? %>
      <div class="sidebar-section">
        <div class="sidebar-section-header">
          <span class="sidebar-section-label">Admin</span>
        </div>
        <div class="sidebar-items">
          <%= link_to admin_dashboard_path, class: "sidebar-item" do %>
            <span class="sidebar-item-icon">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </span>
            <span class="sidebar-item-label">Admin Dashboard</span>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>

  <!-- User footer -->
  <div class="sidebar-footer">
    <div class="sidebar-user-row group">
      <div class="sidebar-user-info">
        <div class="flex-shrink-0">
          <%= avatar_for(current_user, size: 'h-8 w-8') %>
        </div>
        <div class="min-w-0">
          <p class="sidebar-username"><%= current_user.username %></p>
          <p class="sidebar-user-status">
            <% if user_online?(current_user) %>
              <%= status_with_dot('Online', kind: :ok, class_name: 'text-green-500') %>
            <% else %>
              <span class="text-stone-400"><%= last_seen_text(current_user) %></span>
            <% end %>
          </p>
        </div>
      </div>

      <div class="sidebar-user-actions">
        <%= link_to edit_settings_path,
            class: "sidebar-action-btn",
            title: "Settings",
            "aria-label": "Settings" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        <% end %>
        <%= link_to signout_path,
            data: { turbo_method: :delete, turbo_confirm: "Sign out?" },
            class: "sidebar-action-btn danger",
            title: "Sign Out",
            "aria-label": "Sign out" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
          </svg>
        <% end %>
      </div>
    </div>
  </div>
</div>
