<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || Setting.fetch(:site_name, 'HomeChat') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <meta name="theme-color" content="<%= Setting.fetch(:pwa_theme_color, '#2563eb') %>">
  </head>

  <body class="antialiased font-sans bg-white text-gray-900" data-controller="shortcuts">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-4 focus:left-4 focus:px-4 focus:py-2 focus:rounded-md focus:bg-white focus:text-blue-600 focus:shadow">Skip to main content</a>
    <% if ActiveModel::Type::Boolean.new.cast(Setting.fetch(:pwa_enabled, true)) %>
      <div data-controller="install-prompt" data-install-prompt-target="toast" class="hidden fixed bottom-6 right-6 z-40">
        <div class="flex items-center space-x-3 px-4 py-3 bg-gray-900 text-white rounded-lg shadow-lg">
          <span>Install this app?</span>
          <button class="px-3 py-1 rounded-md bg-blue-600 hover:bg-blue-700" data-action="install-prompt#install">Install</button>
          <button class="text-white/70 hover:text-white" aria-label="Dismiss" data-action="install-prompt#dismiss">✕</button>
        </div>
      </div>
    <% end %>
    <% if ActiveModel::Type::Boolean.new.cast(Setting.fetch(:pwa_enabled, true)) %>
      <%= javascript_tag nonce: true do %>
        if ('serviceWorker' in navigator) { navigator.serviceWorker.register('<%= pwa_service_worker_path %>') }
      <% end %>
    <% end %>
    <% if logged_in? %>
      <span data-current-username data-current-username="<%= current_user.username %>" class="hidden"></span>

      <%# Command Palette - Cmd+K quick switcher %>
      <% palette_channels = (@sidebar_my_channels || []).map { |c| { id: c.id, name: c.name, url: channel_path(c), type: c.channel_type } } +
                            (@sidebar_dm_channels || []).map { |c| { id: c.id, name: c.other_user(current_user)&.username || c.name, url: channel_path(c), type: 'dm' } } %>
      <div data-controller="command-palette" data-command-palette-channels-value="<%= palette_channels.to_json %>">
        <!-- Backdrop -->
        <div data-command-palette-target="backdrop" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50" data-action="click->command-palette#close"></div>

        <!-- Modal -->
        <div data-command-palette-target="modal" class="hidden fixed inset-0 z-50 items-start justify-center pt-[15vh] px-4">
          <div class="w-full max-w-lg bg-white rounded-xl shadow-2xl border border-gray-200 overflow-hidden" role="dialog" aria-modal="true" aria-label="Quick switcher">
            <!-- Search Input -->
            <div class="px-4 py-3 border-b border-gray-200">
              <div class="flex items-center gap-3">
                <svg class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <input type="text"
                       data-command-palette-target="input"
                       data-action="input->command-palette#search keydown->command-palette#handleInputKeydown"
                       class="flex-1 text-base text-gray-900 placeholder-gray-500 bg-transparent border-0 focus:outline-none focus:ring-0"
                       placeholder="Search channels..."
                       autocomplete="off"
                       spellcheck="false">
                <kbd class="hidden sm:inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-gray-500 bg-gray-100 rounded">
                  esc
                </kbd>
              </div>
            </div>

            <!-- Results -->
            <div data-command-palette-target="results" class="max-h-[50vh] overflow-y-auto">
              <!-- Results rendered dynamically -->
            </div>

            <!-- Footer hint -->
            <div class="px-4 py-2 border-t border-gray-100 bg-gray-50 text-xs text-gray-500 flex items-center justify-between">
              <span>
                <kbd class="px-1.5 py-0.5 bg-white border border-gray-200 rounded text-gray-600">↑↓</kbd>
                navigate
              </span>
              <span>
                <kbd class="px-1.5 py-0.5 bg-white border border-gray-200 rounded text-gray-600">↵</kbd>
                open
              </span>
              <span class="hidden sm:inline">
                <kbd class="px-1.5 py-0.5 bg-white border border-gray-200 rounded text-gray-600">esc</kbd>
                close
              </span>
            </div>
          </div>
        </div>
      </div>
    <% end %>
    <%# Global flashes removed from full-width; shown inside main content below %>

    <div class="relative flex min-h-dvh md:h-dvh md:overflow-hidden bg-gray-100" data-controller="sidebar">
      <!-- Backdrop (mobile) - with blur effect -->
      <div class="fixed inset-0 bg-black/30 backdrop-blur-sm z-30 hidden md:hidden transition-opacity duration-200" data-sidebar-target="backdrop" data-action="click->sidebar#close" aria-hidden="true"></div>

      <!-- Sidebar - with spring animation -->
      <aside class="fixed inset-y-0 left-0 z-40 w-64 transform -translate-x-full transition-transform duration-300 ease-spring bg-gray-50 border-r border-gray-200 text-gray-900 flex flex-col shadow-xl md:relative md:translate-x-0 md:transform-none md:flex-shrink-0 md:w-64 md:h-dvh md:overflow-y-auto md:shadow-none" data-sidebar-target="panel" data-sidebar-panel aria-label="Primary">
        <%= render "shared/channels_sidebar" %>
      </aside>

      <!-- Main Content -->
      <div class="flex-1 flex flex-col min-h-dvh md:h-dvh md:min-h-0 min-w-0 md:overflow-hidden">
        <% top_pad = content_for?(:no_top_padding) ? '' : ' pt-6 sm:pt-8' %>
        <% scroll_class = content_for?(:lock_main_scroll) ? ' overflow-y-auto md:overflow-hidden' : ' overflow-y-auto' %>
        <% scroll_padding = content_for?(:scroll_padding) ? " #{content_for(:scroll_padding).strip}" : '' %>
        <main id="main-content" class="flex-1 flex flex-col min-h-0 bg-white<%= scroll_class %><%= top_pad %><%= scroll_padding %>" tabindex="-1">
          <% if flash[:notice] %>
            <div role="status" aria-live="polite" data-controller="flash" data-flash-timeout-value="4000" class="fixed top-0 start-0 z-50 flex justify-between w-full p-4 border-b border-green-200 bg-green-50 dark:bg-green-800 opacity-100">
              <div class="flex items-center mx-auto">
                <p class="flex items-center text-sm font-normal text-green-800 dark:text-green-300">
                  <span class="inline-flex p-1 me-3 bg-green-200 rounded-full w-6 h-6 dark:bg-green-600">
                    <svg class="w-3 h-3 text-green-500 dark:text-green-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z"/>
                    </svg>
                  </span>
                  <span><%= flash[:notice] %></span>
                </p>
              </div>
              <button type="button" aria-label="Dismiss" class="flex-shrink-0 inline-flex justify-center w-7 h-7 items-center text-green-400 hover:bg-green-200 hover:text-green-900 rounded-lg text-sm p-1.5 dark:hover:bg-green-600 dark:hover:text-green-300" data-action="click->flash#close">
                <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                </svg>
              </button>
            </div>
          <% end %>
          <% if flash[:alert] %>
            <div role="alert" aria-live="assertive" data-controller="flash" data-flash-timeout-value="5000" class="fixed top-0 start-0 z-50 flex justify-between w-full p-4 border-b border-red-200 bg-red-50 dark:bg-red-800 opacity-100">
              <div class="flex items-center mx-auto">
                <p class="flex items-center text-sm font-normal text-red-800 dark:text-red-300">
                  <span class="inline-flex p-1 me-3 bg-red-200 rounded-full w-6 h-6 dark:bg-red-600">
                    <svg class="w-3 h-3 text-red-500 dark:text-red-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 11.793a1 1 0 1 1-1.414 1.414L10 11.414l-2.293 2.293a1 1 0 0 1-1.414-1.414L8.586 10 6.293 7.707a1 1 0 0 1 1.414-1.414L10 8.586l2.293-2.293a1 1 0 0 1 1.414 1.414L11.414 10l2.293 2.293Z"/>
                    </svg>
                  </span>
                  <span><%= flash[:alert] %></span>
                </p>
              </div>
              <button type="button" aria-label="Dismiss" class="flex-shrink-0 inline-flex justify-center w-7 h-7 items-center text-red-400 hover:bg-red-200 hover:text-red-900 rounded-lg text-sm p-1.5 dark:hover:bg-red-600 dark:hover:text-red-300" data-action="click->flash#close">
                <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                </svg>
              </button>
            </div>
          <% end %>
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
