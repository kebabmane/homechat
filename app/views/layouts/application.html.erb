<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || Setting.fetch(:site_name, 'HomeChat') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <meta name="theme-color" content="<%= Setting.fetch(:pwa_theme_color, '#2563eb') %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
  </head>

  <body class="antialiased font-sans bg-stone-50 text-stone-900" data-controller="shortcuts">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-4 focus:left-4 focus:px-4 focus:py-2 focus:rounded-md focus:bg-white focus:text-blue-600 focus:shadow">Skip to main content</a>
    <% pwa_enabled = ActiveModel::Type::Boolean.new.cast(Setting.fetch(:pwa_enabled, true)) %>
    <% show_install_prompt = pwa_enabled && !content_for?(:lock_main_scroll) %>
    <% if show_install_prompt %>
      <div data-controller="install-prompt"
           data-install-prompt-target="toast"
           class="hidden fixed top-16 inset-x-3 sm:top-auto sm:inset-x-auto sm:bottom-6 sm:right-6 z-40">
        <div class="flex items-center justify-between gap-2 px-3 py-2.5 bg-gray-900 text-white rounded-lg shadow-lg">
          <span class="text-sm">Install this app?</span>
          <button class="px-3 py-1 rounded-md bg-blue-600 hover:bg-blue-700 text-sm font-medium" data-action="install-prompt#install">Install</button>
          <button class="text-white/70 hover:text-white leading-none" aria-label="Dismiss" data-action="install-prompt#dismiss">✕</button>
        </div>
      </div>
    <% end %>
    <% if pwa_enabled %>
      <%= javascript_tag nonce: true do %>
        if ('serviceWorker' in navigator) { navigator.serviceWorker.register('<%= pwa_service_worker_path %>') }
      <% end %>
    <% end %>
    <% if logged_in? %>
      <span data-current-username data-current-username="<%= current_user.username %>" class="hidden"></span>

      <%# Command Palette - Cmd+K quick switcher %>
      <% palette_channels = (@sidebar_my_channels || []).map { |c| { id: c.id, name: c.name, url: channel_path(c), type: c.channel_type } } +
                            (@sidebar_dm_channels || []).map { |c| { id: c.id, name: @sidebar_dm_names_by_channel_id&.[](c.id) || c.name, url: channel_path(c), type: 'dm' } } %>
      <div data-controller="command-palette" data-command-palette-channels-value="<%= palette_channels.to_json %>">
        <!-- Backdrop -->
        <div data-command-palette-target="backdrop" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50" data-action="click->command-palette#close"></div>

        <!-- Modal -->
        <div data-command-palette-target="modal" class="hidden fixed inset-0 z-50 items-start justify-center pt-[15vh] px-4">
          <div class="w-full max-w-lg bg-white rounded-xl shadow-2xl border border-gray-200 overflow-hidden" role="dialog" aria-modal="true" aria-label="Quick switcher">
            <!-- Search Input -->
            <div class="px-4 py-3 border-b border-gray-200">
              <div class="flex items-center gap-3">
                <svg class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <input type="text"
                       data-command-palette-target="input"
                       data-action="input->command-palette#search keydown->command-palette#handleInputKeydown"
                       class="flex-1 text-base text-gray-900 placeholder-gray-500 bg-transparent border-0 focus:outline-none focus:ring-0"
                       placeholder="Search channels..."
                       autocomplete="off"
                       spellcheck="false"
                       role="combobox"
                       aria-autocomplete="list"
                       aria-controls="command-palette-results"
                       aria-expanded="false">
                <kbd class="hidden sm:inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-gray-500 bg-gray-100 rounded">
                  esc
                </kbd>
              </div>
            </div>

            <!-- Results -->
            <div id="command-palette-results"
                 data-command-palette-target="results"
                 class="max-h-[50vh] overflow-y-auto"
                 role="listbox"
                 aria-label="Channel search results">
              <!-- Results rendered dynamically -->
            </div>

            <!-- Footer hint -->
            <div class="px-4 py-2 border-t border-gray-100 bg-gray-50 text-xs text-gray-500 flex items-center justify-between">
              <span>
                <kbd class="px-1.5 py-0.5 bg-white border border-gray-200 rounded text-gray-600">↑↓</kbd>
                navigate
              </span>
              <span>
                <kbd class="px-1.5 py-0.5 bg-white border border-gray-200 rounded text-gray-600">↵</kbd>
                open
              </span>
              <span class="hidden sm:inline">
                <kbd class="px-1.5 py-0.5 bg-white border border-gray-200 rounded text-gray-600">esc</kbd>
                close
              </span>
            </div>
          </div>
        </div>
      </div>
    <% end %>
    <%# Global flashes removed from full-width; shown inside main content below %>

    <div class="relative flex min-h-dvh md:h-dvh md:overflow-hidden bg-stone-50" data-controller="sidebar">
      <!-- Backdrop (mobile) - with blur effect -->
      <div class="fixed inset-0 bg-black/30 backdrop-blur-sm z-30 hidden md:hidden transition-opacity duration-200" data-sidebar-target="backdrop" data-action="click->sidebar#close" aria-hidden="true"></div>

      <!-- Sidebar - with spring animation -->
      <aside class="fixed inset-y-0 left-0 z-40 w-64 transform -translate-x-full transition-transform duration-300 ease-spring bg-white border-r border-stone-200 flex flex-col shadow-2xl md:relative md:translate-x-0 md:transform-none md:flex-shrink-0 md:w-64 md:h-dvh md:overflow-y-auto md:shadow-none" data-sidebar-target="panel" data-sidebar-panel aria-label="Primary">
        <%= render "shared/channels_sidebar" %>
      </aside>

      <!-- Main Content -->
      <div class="flex-1 flex flex-col min-h-dvh md:h-dvh md:min-h-0 min-w-0 md:overflow-hidden">
        <% top_pad = content_for?(:no_top_padding) ? '' : ' pt-6 sm:pt-8' %>
        <% scroll_class = content_for?(:lock_main_scroll) ? ' overflow-y-auto md:overflow-hidden' : ' overflow-y-auto' %>
        <% scroll_padding = content_for?(:scroll_padding) ? " #{content_for(:scroll_padding).strip}" : '' %>
        <main id="main-content" class="flex-1 flex flex-col min-h-0 bg-[var(--main-bg)]<%= scroll_class %><%= top_pad %><%= scroll_padding %>" tabindex="-1">
          <% if flash[:notice] || flash[:alert] %>
            <div class="pointer-events-none fixed inset-x-0 top-3 z-50 flex flex-col items-center gap-2 px-3 sm:items-end sm:px-6">
              <% if flash[:notice] %>
                <div role="status" aria-live="polite" data-controller="flash" data-flash-timeout-value="4000" class="pointer-events-auto app-flash app-flash--notice">
                  <span class="app-flash-icon" aria-hidden="true">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                  <p class="flex-1 min-w-0"><%= flash[:notice] %></p>
                  <button type="button" aria-label="Dismiss" class="app-flash-close" data-action="click->flash#close">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </button>
                </div>
              <% end %>

              <% if flash[:alert] %>
                <div role="alert" aria-live="assertive" data-controller="flash" data-flash-timeout-value="5500" class="pointer-events-auto app-flash app-flash--alert">
                  <span class="app-flash-icon" aria-hidden="true">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v4m0 4h.01M10.29 3.86l-7.07 12.24A2 2 0 004.95 19h14.1a2 2 0 001.73-2.9L13.71 3.86a2 2 0 00-3.42 0z" />
                    </svg>
                  </span>
                  <p class="flex-1 min-w-0"><%= flash[:alert] %></p>
                  <button type="button" aria-label="Dismiss" class="app-flash-close" data-action="click->flash#close">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </button>
                </div>
              <% end %>
            </div>
          <% end %>
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
