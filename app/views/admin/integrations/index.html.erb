<% content_for :title, "Home Assistant Setup" %>

<%= render 'admin/header' %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 pb-24 space-y-8">
  <section class="rounded-xl border border-blue-100 bg-blue-50/70 p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-blue-900 mb-4">Home Assistant Integration Setup</h2>
    <p class="text-sm text-blue-800 mb-6">Follow these steps to connect HomeChat to your Home Assistant instance.</p>

    <ol class="list-decimal ml-5 space-y-6 text-sm text-blue-800">
      <li>
        <span class="font-semibold">Install the custom integration</span>
        <p class="mt-1 text-blue-700">Copy the <code class="font-mono bg-blue-100 px-1 rounded">homechat</code> folder into your Home Assistant config directory:</p>
        <pre class="mt-2 bg-blue-100 text-blue-900 px-3 py-2 rounded-lg text-xs font-mono overflow-x-auto">&lt;ha_config&gt;/custom_components/homechat/</pre>
      </li>

      <li>
        <span class="font-semibold">Create an API token</span>
        <p class="mt-1 text-blue-700">Go to <%= link_to "Admin > Tokens", admin_tokens_path, class: "underline font-medium" %> and create a new token for Home Assistant.</p>
      </li>

      <li>
        <span class="font-semibold">Configure the integration in Home Assistant</span>
        <p class="mt-1 text-blue-700">Add the integration via the Home Assistant UI or <code class="font-mono bg-blue-100 px-1 rounded">configuration.yaml</code>:</p>
        <pre class="mt-2 bg-blue-100 text-blue-900 px-3 py-2 rounded-lg text-xs font-mono overflow-x-auto">homechat:
  host: <%= request.host %>
  port: <%= request.port %>
  ssl: <%= request.ssl? %>
  token: YOUR_API_TOKEN</pre>
      </li>

      <li>
        <span class="font-semibold">Test the connection</span>
        <p class="mt-1 text-blue-700">Click the button below to verify HomeChat can communicate with integrations.</p>
        <div class="mt-3">
          <button type="button" id="test-connection" class="inline-flex items-center justify-center rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">
            Test API Connection
          </button>
          <span id="test-result" class="ml-3 text-sm"></span>
        </div>
      </li>
    </ol>
  </section>

  <section class="rounded-xl border border-gray-200 bg-white shadow-sm p-6">
    <h3 class="text-base font-semibold text-gray-900 mb-3">Current Connection Info</h3>
    <dl class="grid gap-3 text-sm">
      <div class="flex justify-between py-2 border-b border-gray-100">
        <dt class="text-gray-500">Host</dt>
        <dd class="font-mono text-gray-900"><%= request.host %></dd>
      </div>
      <div class="flex justify-between py-2 border-b border-gray-100">
        <dt class="text-gray-500">Port</dt>
        <dd class="font-mono text-gray-900"><%= request.port %></dd>
      </div>
      <div class="flex justify-between py-2 border-b border-gray-100">
        <dt class="text-gray-500">SSL</dt>
        <dd class="text-gray-900"><%= request.ssl? ? '✓ Enabled' : '✗ Disabled' %></dd>
      </div>
      <div class="flex justify-between py-2 border-b border-gray-100">
        <dt class="text-gray-500">API Enabled</dt>
        <dd class="text-gray-900"><%= Setting.fetch('api_enabled', true) ? '✓ Yes' : '✗ No' %></dd>
      </div>
      <div class="flex justify-between py-2">
        <dt class="text-gray-500">Active Tokens</dt>
        <dd class="text-gray-900"><%= ApiToken.active.count %></dd>
      </div>
    </dl>
    <p class="mt-4 text-xs text-gray-500">
      API and integration settings can be configured in <%= link_to "Server Settings", edit_admin_settings_path, class: "underline" %>.
    </p>
  </section>
</div>

<%= javascript_tag nonce: true do %>
(function() {
  const button = document.getElementById('test-connection')
  const result = document.getElementById('test-result')
  if (!button) return

  button.addEventListener('click', () => {
    if (button.dataset.busy === 'true') return
    const original = button.textContent
    button.dataset.busy = 'true'
    button.textContent = 'Testing…'
    button.disabled = true
    result.textContent = ''

    fetch('<%= test_connection_admin_integrations_path %>', {
      headers: { 'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content }
    })
      .then(resp => resp.json())
      .then(data => {
        const ok = data.status === 'success'
        button.textContent = ok ? '✓ Connected' : '✗ Failed'
        button.classList.toggle('bg-emerald-600', ok)
        button.classList.toggle('hover:bg-emerald-700', ok)
        button.classList.toggle('bg-red-600', !ok)
        button.classList.toggle('hover:bg-red-700', !ok)
        result.textContent = data.message || ''
        result.className = 'ml-3 text-sm ' + (ok ? 'text-emerald-600' : 'text-red-600')
      })
      .catch(error => {
        button.textContent = '✗ Failed'
        button.classList.remove('bg-emerald-600', 'hover:bg-emerald-700')
        button.classList.add('bg-red-600', 'hover:bg-red-700')
        result.textContent = error.message
        result.className = 'ml-3 text-sm text-red-600'
      })
      .finally(() => {
        setTimeout(() => {
          button.textContent = original
          button.classList.remove('bg-red-600', 'hover:bg-red-700')
          button.classList.add('bg-emerald-600', 'hover:bg-emerald-700')
          button.dataset.busy = 'false'
          button.disabled = false
        }, 3000)
      })
  })
})()
<% end %>
