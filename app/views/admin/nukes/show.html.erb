<%= render 'admin/header' %>

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 pb-14">
  <div class="rounded-xl border-2 border-red-300 bg-red-50 p-6 shadow-sm">
    <div class="flex items-start gap-4 mb-6">
      <div class="h-12 w-12 flex-shrink-0 rounded-full bg-red-100 text-red-700 flex items-center justify-center">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
        </svg>
      </div>
      <div>
        <h2 class="text-xl font-bold text-red-900">Nuke All Data</h2>
        <p class="mt-1 text-sm text-red-700">This action is <strong>irreversible</strong>. All messages and channels will be permanently deleted from the server and all connected clients will be notified to clear their local caches.</p>
      </div>
    </div>

    <div class="mb-6 rounded-lg border border-red-200 bg-white p-4">
      <h3 class="text-sm font-semibold text-red-900 mb-3">The following data will be permanently deleted:</h3>
      <ul class="space-y-1.5 text-sm text-red-800">
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-red-500 flex-shrink-0"></span>
          All messages and media attachments
        </li>
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-red-500 flex-shrink-0"></span>
          All public and private channels
        </li>
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-red-500 flex-shrink-0"></span>
          All direct message channels
        </li>
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-red-500 flex-shrink-0"></span>
          All channel memberships
        </li>
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-red-500 flex-shrink-0"></span>
          All message read receipts
        </li>
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-red-500 flex-shrink-0"></span>
          All E2EE keys and key shares
        </li>
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-red-500 flex-shrink-0"></span>
          All registered push notification tokens
        </li>
        <li class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-red-500 flex-shrink-0"></span>
          All stored file blobs
        </li>
      </ul>

      <div class="mt-3 pt-3 border-t border-red-100">
        <h4 class="text-sm font-semibold text-green-800 mb-2">The following data will be preserved:</h4>
        <ul class="space-y-1 text-sm text-green-700">
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-green-500 flex-shrink-0"></span>
            User accounts
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-green-500 flex-shrink-0"></span>
            API tokens and bot integrations
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-green-500 flex-shrink-0"></span>
            Server settings
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-green-500 flex-shrink-0"></span>
            Audit logs (including this event)
          </li>
        </ul>
      </div>
    </div>

    <%= form_with url: admin_nuke_path, method: :post, data: { controller: "nuke-confirm" } do |f| %>
      <div class="mb-4">
        <label for="confirmation" class="block text-sm font-medium text-red-900 mb-1">
          Type <code class="rounded bg-red-100 px-1 py-0.5 font-mono text-red-800">NUKE</code> to confirm:
        </label>
        <%= f.text_field :confirmation,
              id: "confirmation",
              autocomplete: "off",
              placeholder: "NUKE",
              class: "block w-full rounded-md border border-red-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500",
              data: { action: "input->nuke-confirm#check", "nuke-confirm-target": "input" } %>
      </div>

      <%= f.submit "Permanently Delete All Data",
            class: "w-full rounded-md bg-red-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 disabled:opacity-40 disabled:cursor-not-allowed cursor-not-allowed opacity-40",
            disabled: true,
            data: { "nuke-confirm-target": "submit" } %>
    <% end %>
  </div>

  <div class="mt-4 text-center">
    <%= link_to "Cancel — go back to dashboard", admin_dashboard_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>
</div>

<script>
  // Stimulus-style inline controller to avoid a separate JS file
  document.addEventListener("DOMContentLoaded", function () {
    const input = document.querySelector('[data-nuke-confirm-target="input"]');
    const submit = document.querySelector('[data-nuke-confirm-target="submit"]');
    if (!input || !submit) return;

    input.addEventListener("input", function () {
      const confirmed = input.value === "NUKE";
      submit.disabled = !confirmed;
      submit.classList.toggle("opacity-40", !confirmed);
      submit.classList.toggle("cursor-not-allowed", !confirmed);
      submit.classList.toggle("cursor-pointer", confirmed);
    });
  });
</script>
