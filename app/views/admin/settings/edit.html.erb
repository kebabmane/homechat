<%= render 'admin/header' %>

<div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 pb-24">
  <%= form_with url: admin_settings_path, method: :patch, local: true, html: { class: 'w-full' } do %>
    <!-- Tabs Container -->
    <div data-controller="tabs" data-tabs-active-value="general" class="w-full">

      <!-- Tab Bar -->
      <div class="w-full flex gap-1 border-b border-stone-200 mb-6">
        <button type="button" data-tabs-target="tab" data-tabs-id="general" data-action="click->tabs#select"
                class="inline-flex items-center gap-2 px-5 py-3 text-sm font-medium rounded-t-lg border-b-2 transition-colors
                       text-stone-500 border-transparent hover:text-stone-700 hover:border-stone-300
                       [&.is-active]:text-amber-700 [&.is-active]:border-amber-500 [&.is-active]:bg-amber-50">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          General
        </button>

        <button type="button" data-tabs-target="tab" data-tabs-id="pwa" data-action="click->tabs#select"
                class="inline-flex items-center gap-2 px-5 py-3 text-sm font-medium rounded-t-lg border-b-2 transition-colors
                       text-stone-500 border-transparent hover:text-stone-700 hover:border-stone-300
                       [&.is-active]:text-amber-700 [&.is-active]:border-amber-500 [&.is-active]:bg-amber-50">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
          PWA
        </button>

        <button type="button" data-tabs-target="tab" data-tabs-id="api" data-action="click->tabs#select"
                class="inline-flex items-center gap-2 px-5 py-3 text-sm font-medium rounded-t-lg border-b-2 transition-colors
                       text-stone-500 border-transparent hover:text-stone-700 hover:border-stone-300
                       [&.is-active]:text-amber-700 [&.is-active]:border-amber-500 [&.is-active]:bg-amber-50">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
          </svg>
          API
        </button>

        <button type="button" data-tabs-target="tab" data-tabs-id="notifications" data-action="click->tabs#select"
                class="inline-flex items-center gap-2 px-5 py-3 text-sm font-medium rounded-t-lg border-b-2 transition-colors
                       text-stone-500 border-transparent hover:text-stone-700 hover:border-stone-300
                       [&.is-active]:text-amber-700 [&.is-active]:border-amber-500 [&.is-active]:bg-amber-50">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
          </svg>
          Notifications
        </button>

        <button type="button" data-tabs-target="tab" data-tabs-id="ai" data-action="click->tabs#select"
                class="inline-flex items-center gap-2 px-5 py-3 text-sm font-medium rounded-t-lg border-b-2 transition-colors
                       text-stone-500 border-transparent hover:text-stone-700 hover:border-stone-300
                       [&.is-active]:text-amber-700 [&.is-active]:border-amber-500 [&.is-active]:bg-amber-50">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
          AI & LiteLLM
        </button>
      </div>

      <!-- General Panel -->
      <div data-tabs-target="panel" data-tabs-id="general" class="w-full bg-white/90 rounded-2xl border border-stone-200 p-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div>
            <h3 class="text-sm font-medium text-stone-900 mb-4">Site Settings</h3>
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-stone-700 mb-2">Site name</label>
                <input type="text" name="site_name" value="<%= @site_name %>" class="block w-full rounded-lg border-stone-300 py-2.5 text-sm focus:ring-amber-500 focus:border-amber-500">
                <p class="mt-1.5 text-xs text-stone-500">Shown in window titles and the sidebar header.</p>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-stone-900 mb-4">User Registration</h3>
            <div class="space-y-4">
              <label class="flex items-start gap-3 cursor-pointer p-3 rounded-lg hover:bg-stone-50 transition-colors border border-stone-200">
                <input type="checkbox" id="allow_signups" name="allow_signups" value="1" <%= 'checked' if @allow_signups %> class="mt-0.5 h-4 w-4 rounded border-stone-300 text-amber-600 focus:ring-amber-500">
                <div>
                  <span class="text-sm font-medium text-stone-900">Allow new user sign-ups</span>
                  <p class="text-sm text-stone-500">Enable public registration on the login page.</p>
                </div>
              </label>

              <label class="flex items-start gap-3 cursor-pointer p-3 rounded-lg hover:bg-stone-50 transition-colors border border-stone-200">
                <input type="checkbox" id="require_signup_approval" name="require_signup_approval" value="1" <%= 'checked' if @require_signup_approval %> class="mt-0.5 h-4 w-4 rounded border-stone-300 text-amber-600 focus:ring-amber-500">
                <div>
                  <span class="text-sm font-medium text-stone-900">Require admin approval</span>
                  <p class="text-sm text-stone-500">New users must be approved before accessing the server.</p>
                </div>
              </label>
            </div>
          </div>
        </div>
      </div>

      <!-- PWA Panel -->
      <div data-tabs-target="panel" data-tabs-id="pwa" class="hidden w-full bg-white/90 rounded-2xl border border-stone-200 p-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div>
            <h3 class="text-sm font-medium text-stone-900 mb-4">Progressive Web App</h3>
            <div class="space-y-4">
              <label class="flex items-start gap-3 cursor-pointer p-3 rounded-lg hover:bg-stone-50 transition-colors border border-stone-200">
                <input type="checkbox" id="pwa_enabled" name="pwa_enabled" value="1" <%= 'checked' if @pwa_enabled %> class="mt-0.5 h-4 w-4 rounded border-stone-300 text-amber-600 focus:ring-amber-500">
                <div>
                  <span class="text-sm font-medium text-stone-900">Enable installable PWA</span>
                  <p class="text-sm text-stone-500">Allow users to install HomeChat as a standalone app with offline support.</p>
                </div>
              </label>

              <div>
                <label class="block text-sm font-medium text-stone-700 mb-2">Short name</label>
                <input type="text" name="pwa_short_name" value="<%= @pwa_short_name %>" class="block w-full rounded-lg border-stone-300 py-2.5 text-sm focus:ring-amber-500 focus:border-amber-500">
                <p class="mt-1.5 text-xs text-stone-500">Displayed on home screens and app launchers.</p>
              </div>

              <div>
                <label class="block text-sm font-medium text-stone-700 mb-2">Display mode</label>
                <select name="pwa_display" class="block w-full rounded-lg border-stone-300 py-2.5 text-sm focus:ring-amber-500 focus:border-amber-500">
                  <option value="standalone" <%= 'selected' if @pwa_display == 'standalone' %>>Standalone (app-like)</option>
                  <option value="browser" <%= 'selected' if @pwa_display == 'browser' %>>Browser (tabs + URL bar)</option>
                </select>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-stone-900 mb-4">Appearance</h3>
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-stone-700 mb-2">Theme color</label>
                <input type="text" name="pwa_theme_color" value="<%= @pwa_theme_color %>" placeholder="#2563eb" class="block w-full rounded-lg border-stone-300 py-2.5 text-sm focus:ring-amber-500 focus:border-amber-500">
                <p class="mt-1.5 text-xs text-stone-500">Browser toolbar color on mobile devices.</p>
              </div>

              <div>
                <label class="block text-sm font-medium text-stone-700 mb-2">Background color</label>
                <input type="text" name="pwa_bg_color" value="<%= @pwa_bg_color %>" placeholder="#ffffff" class="block w-full rounded-lg border-stone-300 py-2.5 text-sm focus:ring-amber-500 focus:border-amber-500">
                <p class="mt-1.5 text-xs text-stone-500">Splash screen background color.</p>
              </div>

              <div class="p-3 bg-stone-50 rounded-lg border border-stone-200">
                <p class="text-xs text-stone-600">Icons are served from <code class="font-mono bg-stone-200 px-1 rounded">/icon.png</code> and <code class="font-mono bg-stone-200 px-1 rounded">/icon.svg</code>.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- API Panel -->
      <div data-tabs-target="panel" data-tabs-id="api" class="hidden w-full space-y-6">
        <!-- API Settings -->
        <div class="bg-white/90 rounded-2xl border border-stone-200 p-6">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div>
              <h3 class="text-sm font-medium text-stone-900 mb-4">API & Integrations</h3>
              <div class="space-y-4">
                <label class="flex items-start gap-3 cursor-pointer p-3 rounded-lg hover:bg-green-50 transition-colors border border-green-200 bg-green-50/50">
                  <input type="checkbox" id="api_enabled" name="api_enabled" value="1" <%= 'checked' if @api_enabled %> class="mt-0.5 h-4 w-4 rounded border-stone-300 text-green-600 focus:ring-green-500">
                  <div>
                    <span class="text-sm font-medium text-stone-900">Enable REST API</span>
                    <p class="text-sm text-stone-500">Allow external integrations to access HomeChat via the API.</p>
                  </div>
                </label>

                <label class="flex items-start gap-3 cursor-pointer p-3 rounded-lg hover:bg-green-50 transition-colors border border-green-200 bg-green-50/50">
                  <input type="checkbox" id="home_assistant_enabled" name="home_assistant_enabled" value="1" <%= 'checked' if @home_assistant_enabled %> class="mt-0.5 h-4 w-4 rounded border-stone-300 text-green-600 focus:ring-green-500">
                  <div>
                    <span class="text-sm font-medium text-stone-900">Enable Home Assistant</span>
                    <p class="text-sm text-stone-500">Connect HomeChat with your Home Assistant instance.</p>
                  </div>
                </label>
              </div>
            </div>

            <div>
              <h3 class="text-sm font-medium text-stone-900 mb-4">Webhook Configuration</h3>
              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-stone-700 mb-2">Webhook base URL</label>
                  <input type="text" name="webhook_base_url" value="<%= @webhook_base_url %>" placeholder="<%= request.base_url %>" class="block w-full rounded-lg border-stone-300 py-2.5 text-sm focus:ring-green-500 focus:border-green-500">
                  <p class="mt-1.5 text-xs text-stone-500">Base URL for webhook callbacks. Auto-detected if left blank.</p>
                </div>

                <div class="p-3 bg-green-50 rounded-lg border border-green-200">
                  <p class="text-xs text-green-700">API tokens can be managed in <%= link_to 'Automations > API Tokens', admin_bots_path, class: 'font-medium underline' %>.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Connection Info -->
        <div class="bg-white/90 rounded-2xl border border-stone-200 p-6">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div>
              <h3 class="text-sm font-medium text-stone-900 mb-4">Current Connection Info</h3>
              <dl class="grid gap-2 text-sm">
                <div class="flex justify-between py-2 border-b border-stone-100">
                  <dt class="text-stone-500">Host</dt>
                  <dd class="font-mono text-stone-900"><%= request.host %></dd>
                </div>
                <div class="flex justify-between py-2 border-b border-stone-100">
                  <dt class="text-stone-500">Port</dt>
                  <dd class="font-mono text-stone-900"><%= request.port %></dd>
                </div>
                <div class="flex justify-between py-2 border-b border-stone-100">
                  <dt class="text-stone-500">SSL</dt>
                  <dd class="text-stone-900"><%= request.ssl? ? 'Enabled' : 'Disabled' %></dd>
                </div>
                <div class="flex justify-between py-2 border-b border-stone-100">
                  <dt class="text-stone-500">API Enabled</dt>
                  <dd class="text-stone-900"><%= @api_enabled ? 'Yes' : 'No' %></dd>
                </div>
                <div class="flex justify-between py-2">
                  <dt class="text-stone-500">Active Tokens</dt>
                  <dd class="text-stone-900"><%= @active_api_tokens_count %></dd>
                </div>
              </dl>
            </div>

            <div>
              <h3 class="text-sm font-medium text-stone-900 mb-4">Test Connection</h3>
              <p class="text-sm text-stone-600 mb-4">Verify that HomeChat can communicate with external integrations.</p>
              <button type="button" id="test-api-connection" class="inline-flex items-center justify-center rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">
                Test API Connection
              </button>
              <span id="test-api-result" class="ml-3 text-sm"></span>
            </div>
          </div>
        </div>

        <!-- Home Assistant Setup Guide -->
        <details class="bg-blue-50/70 rounded-xl border border-blue-100 shadow-sm group">
          <summary class="px-6 py-4 cursor-pointer list-none flex items-center justify-between">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
              </svg>
              <div>
                <h3 class="text-base font-semibold text-blue-900">Home Assistant Setup Guide</h3>
                <p class="text-sm text-blue-700">Step-by-step instructions to connect HomeChat with Home Assistant</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-blue-600 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <div class="px-6 pb-6 pt-2">
            <ol class="list-decimal ml-5 space-y-5 text-sm text-blue-800">
              <li>
                <span class="font-semibold">Install the custom integration</span>
                <p class="mt-1 text-blue-700">Copy the <code class="font-mono bg-blue-100 px-1 rounded">homechat</code> folder into your Home Assistant config directory:</p>
                <pre class="mt-2 bg-blue-100 text-blue-900 px-3 py-2 rounded-lg text-xs font-mono overflow-x-auto">&lt;ha_config&gt;/custom_components/homechat/</pre>
              </li>

              <li>
                <span class="font-semibold">Create an API token</span>
                <p class="mt-1 text-blue-700">Go to <%= link_to "Automations > API Tokens", admin_bots_path, class: "underline font-medium" %> and create a new token for Home Assistant.</p>
              </li>

              <li>
                <span class="font-semibold">Configure the integration in Home Assistant</span>
                <p class="mt-1 text-blue-700">Add the integration via the Home Assistant UI or <code class="font-mono bg-blue-100 px-1 rounded">configuration.yaml</code>:</p>
                <pre class="mt-2 bg-blue-100 text-blue-900 px-3 py-2 rounded-lg text-xs font-mono overflow-x-auto">homechat:
  host: <%= request.host %>
  port: <%= request.port %>
  ssl: <%= request.ssl? %>
  token: YOUR_API_TOKEN</pre>
              </li>

              <li>
                <span class="font-semibold">Test the connection</span>
                <p class="mt-1 text-blue-700">Use the "Test API Connection" button above to verify HomeChat can communicate with integrations.</p>
              </li>
            </ol>
          </div>
        </details>
      </div>

      <!-- Notifications Panel -->
      <div data-tabs-target="panel" data-tabs-id="notifications" class="hidden w-full bg-white/90 rounded-2xl border border-stone-200 p-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div>
            <h3 class="text-sm font-medium text-stone-900 mb-4">Push Notifications (FCM)</h3>
            <div class="space-y-4">
              <label class="flex items-start gap-3 cursor-pointer p-3 rounded-lg hover:bg-orange-50 transition-colors border border-orange-200 bg-orange-50/50">
                <input type="checkbox" id="fcm_enabled" name="fcm_enabled" value="1" <%= 'checked' if @fcm_enabled %> class="mt-0.5 h-4 w-4 rounded border-stone-300 text-orange-600 focus:ring-orange-500">
                <div>
                  <span class="text-sm font-medium text-stone-900">Enable push notifications</span>
                  <% if @fcm_configured %>
                    <span class="ml-2 inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Configured</span>
                  <% end %>
                  <p class="text-sm text-stone-500">Send notifications to mobile devices via Firebase.</p>
                </div>
              </label>

              <div>
                <label class="block text-sm font-medium text-stone-700 mb-2">Firebase Project ID</label>
                <input type="text" name="fcm_project_id" value="<%= @fcm_project_id %>" placeholder="my-homechat-project" class="block w-full rounded-lg border-stone-300 py-2.5 text-sm focus:ring-orange-500 focus:border-orange-500">
                <p class="mt-1.5 text-xs text-stone-500">Found in your Firebase Console project settings.</p>
              </div>

              <div>
                <label class="block text-sm font-medium text-stone-700 mb-2">Service Account Client Email</label>
                <input type="text" name="fcm_client_email" value="<%= @fcm_client_email %>" placeholder="firebase-adminsdk-xxxxx@my-project.iam.gserviceaccount.com" class="block w-full rounded-lg border-stone-300 py-2.5 text-sm focus:ring-orange-500 focus:border-orange-500">
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-stone-900 mb-4">Service Account Key</h3>
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-stone-700 mb-2">Private Key</label>
                <textarea name="fcm_private_key" rows="4" placeholder="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----" class="block w-full rounded-lg border-stone-300 py-2.5 text-sm focus:ring-orange-500 focus:border-orange-500 font-mono text-xs"></textarea>
                <% if @fcm_private_key_present %>
                  <p class="mt-1.5 text-xs text-stone-500">A key is already stored. Leave blank to keep it.</p>
                  <label class="mt-2 inline-flex items-center gap-2 text-xs text-stone-600 cursor-pointer">
                    <input type="checkbox" id="reset_fcm_private_key" name="reset_fcm_private_key" value="1" class="h-4 w-4 rounded border-stone-300 text-orange-600 focus:ring-orange-500">
                    Reset stored key
                  </label>
                <% else %>
                  <p class="mt-1.5 text-xs text-stone-500">The private_key from your Firebase service account JSON.</p>
                <% end %>
              </div>

              <div class="p-3 bg-orange-50 rounded-lg border border-orange-200">
                <p class="text-xs text-orange-700">Download your service account JSON from Firebase Console → Project Settings → Service Accounts → Generate new private key.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- AI Panel -->
      <div data-tabs-target="panel" data-tabs-id="ai" class="hidden w-full bg-white/90 rounded-2xl border border-stone-200 p-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div>
            <h3 class="text-sm font-medium text-stone-900 mb-4">LiteLLM Configuration</h3>
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-stone-700 mb-2">LiteLLM host</label>
                <input type="text" name="litellm_host" value="<%= @litellm_host %>" placeholder="http://127.0.0.1:4000" class="block w-full rounded-lg border-stone-300 py-2.5 text-sm focus:ring-purple-500 focus:border-purple-500">
                <p class="mt-1.5 text-xs text-stone-500">HomeChat will call <code class="font-mono bg-stone-200 px-1 rounded">/v1/models</code> and <code class="font-mono bg-stone-200 px-1 rounded">/v1/chat/completions</code> on this URL.</p>
                <% if @litellm_error.present? %>
                  <p class="mt-1.5 text-xs text-rose-600"><%= @litellm_error %></p>
                <% end %>
              </div>

              <div>
                <label class="block text-sm font-medium text-stone-700 mb-2">LiteLLM API key</label>
                <input type="password" name="litellm_api_key" value="" placeholder="sk-live-..." autocomplete="off" class="block w-full rounded-lg border-stone-300 py-2.5 text-sm focus:ring-purple-500 focus:border-purple-500">
                <% if @litellm_api_key_present %>
                  <p class="mt-1.5 text-xs text-stone-500">A key is already stored. Leave blank to keep it.</p>
                  <label class="mt-2 inline-flex items-center gap-2 text-xs text-stone-600 cursor-pointer">
                    <input type="checkbox" id="reset_litellm_api_key" name="reset_litellm_api_key" value="1" class="h-4 w-4 rounded border-stone-300 text-purple-600 focus:ring-purple-500">
                    Reset stored key
                  </label>
                <% else %>
                  <p class="mt-1.5 text-xs text-stone-500">Required for authentication with your LiteLLM instance.</p>
                <% end %>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-stone-900 mb-4">Model Settings</h3>
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-stone-700 mb-2">Default model</label>
                <% if @litellm_models.present? %>
                  <select name="litellm_default_model" class="block w-full rounded-lg border-stone-300 py-2.5 text-sm focus:ring-purple-500 focus:border-purple-500">
                    <option value="">Select a model</option>
                    <% @litellm_models.each do |model| %>
                      <option value="<%= model %>" <%= 'selected' if model == @litellm_default_model %>><%= model %></option>
                    <% end %>
                  </select>
                  <p class="mt-1.5 text-xs text-stone-500">Used when AI bots do not override their model.</p>
                <% else %>
                  <input type="text" name="litellm_default_model" value="<%= @litellm_default_model %>" placeholder="gpt-4o-mini" class="block w-full rounded-lg border-stone-300 py-2.5 text-sm focus:ring-purple-500 focus:border-purple-500">
                  <p class="mt-1.5 text-xs text-stone-500">Configure the host above to fetch available models, or enter manually.</p>
                <% end %>
              </div>

              <div class="p-3 bg-purple-50 rounded-lg border border-purple-200">
                <p class="text-xs text-purple-700">AI bots can be configured in the <%= link_to 'Bots', admin_bots_path, class: 'font-medium underline' %> section.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Save Button -->
    <div class="mt-6 flex justify-end">
      <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-stone-900 px-6 py-2.5 text-sm font-semibold text-white hover:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-stone-500 focus:ring-offset-2 cursor-pointer transition-colors">
        Save Settings
      </button>
    </div>
  <% end %>
</div>

<%= javascript_tag nonce: true do %>
(function() {
  const button = document.getElementById('test-api-connection')
  const result = document.getElementById('test-api-result')
  if (!button) return

  button.addEventListener('click', () => {
    if (button.dataset.busy === 'true') return
    const original = button.textContent
    button.dataset.busy = 'true'
    button.textContent = 'Testing...'
    button.disabled = true
    result.textContent = ''

    fetch('<%= admin_integrations_test_connection_path %>', {
      headers: { 'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content }
    })
      .then(resp => resp.json())
      .then(data => {
        const ok = data.status === 'success'
        button.textContent = ok ? 'Connected' : 'Failed'
        button.classList.toggle('bg-emerald-600', ok)
        button.classList.toggle('hover:bg-emerald-700', ok)
        button.classList.toggle('bg-red-600', !ok)
        button.classList.toggle('hover:bg-red-700', !ok)
        result.textContent = data.message || ''
        result.className = 'ml-3 text-sm ' + (ok ? 'text-emerald-600' : 'text-red-600')
      })
      .catch(error => {
        button.textContent = 'Failed'
        button.classList.remove('bg-emerald-600', 'hover:bg-emerald-700')
        button.classList.add('bg-red-600', 'hover:bg-red-700')
        result.textContent = error.message
        result.className = 'ml-3 text-sm text-red-600'
      })
      .finally(() => {
        setTimeout(() => {
          button.textContent = original
          button.classList.remove('bg-red-600', 'hover:bg-red-700')
          button.classList.add('bg-emerald-600', 'hover:bg-emerald-700')
          button.dataset.busy = 'false'
          button.disabled = false
        }, 3000)
      })
  })
})()
<% end %>
