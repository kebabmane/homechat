<%= render 'admin/header' %>

<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 pb-24">
  <!-- Tabs Container -->
  <div data-controller="tabs" data-tabs-active-value="<%= params[:tab].presence || 'bots' %>" class="w-full">

    <!-- Tab Bar -->
    <div class="w-full flex gap-1 border-b border-gray-200 mb-6">
      <button type="button" data-tabs-target="tab" data-tabs-id="bots" data-action="click->tabs#select"
              class="inline-flex items-center gap-2 px-5 py-3 text-sm font-medium rounded-t-lg border-b-2 transition-colors
                     text-gray-500 border-transparent hover:text-gray-700 hover:border-gray-300
                     [&.is-active]:text-purple-600 [&.is-active]:border-purple-600 [&.is-active]:bg-purple-50">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        Bots
        <span class="text-xs bg-purple-100 text-purple-700 px-2 py-0.5 rounded-full"><%= @bots.size %></span>
      </button>

      <button type="button" data-tabs-target="tab" data-tabs-id="tokens" data-action="click->tabs#select"
              class="inline-flex items-center gap-2 px-5 py-3 text-sm font-medium rounded-t-lg border-b-2 transition-colors
                     text-gray-500 border-transparent hover:text-gray-700 hover:border-gray-300
                     [&.is-active]:text-blue-600 [&.is-active]:border-blue-600 [&.is-active]:bg-blue-50">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
        </svg>
        API Tokens
        <span class="text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full"><%= @tokens.size %></span>
      </button>
    </div>

    <!-- Bots Panel -->
    <div data-tabs-target="panel" data-tabs-id="bots" class="w-full space-y-6">
      <section class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
        <header class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <div>
            <h2 class="text-lg font-semibold text-gray-900">Automation bots</h2>
            <span class="block text-sm text-gray-500"><%= @bots.size %> configured</span>
          </div>
          <%= link_to 'New AI bot', new_admin_bot_path, class: 'inline-flex items-center rounded-md bg-purple-600 px-4 py-2 text-sm font-medium text-white hover:bg-purple-700 shadow-sm' %>
        </header>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50 text-xs uppercase text-gray-500">
              <tr>
                <th scope="col" class="px-5 py-3 text-left">Name</th>
                <th scope="col" class="px-5 py-3 text-left">Type</th>
                <th scope="col" class="px-5 py-3 text-left">Webhook</th>
                <th scope="col" class="px-5 py-3 text-left">Status</th>
                <th scope="col" class="px-5 py-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 text-sm text-gray-700">
              <% @bots.each do |bot| %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-5 py-3 font-medium text-gray-900"><%= bot.name %></td>
                  <td class="px-5 py-3"><%= bot.bot_type %></td>
                  <td class="px-5 py-3 font-mono text-xs"><%= bot.webhook_id.presence || '—' %></td>
                  <td class="px-5 py-3">
                    <span class="status-dot <%= bot.active? ? 'status-dot--ok' : 'status-dot--warn' %> mr-2"></span>
                    <span><%= bot.active? ? 'Active' : 'Inactive' %></span>
                  </td>
                  <td class="px-5 py-3">
                    <div class="flex flex-wrap justify-end gap-2">
                      <%= link_to "View", admin_bot_path(bot), "aria-label": "View #{bot.name}", class: "inline-flex items-center rounded-md bg-gray-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-gray-700" %>
                      <% if bot.active? %>
                        <%= button_to "Deactivate", deactivate_admin_bot_path(bot), method: :post, "aria-label": "Deactivate #{bot.name}", class: "inline-flex items-center rounded-md bg-amber-500 px-3 py-1.5 text-xs font-medium text-white hover:bg-amber-600" %>
                      <% else %>
                        <%= button_to "Activate", activate_admin_bot_path(bot), method: :post, "aria-label": "Activate #{bot.name}", class: "inline-flex items-center rounded-md bg-blue-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-blue-700" %>
                      <% end %>
                      <%= button_to "Delete", admin_bot_path(bot), method: :delete, "aria-label": "Delete #{bot.name}", data: { turbo_confirm: "Delete bot #{bot.name}?" }, class: "inline-flex items-center rounded-md bg-red-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-red-700" %>
                    </div>
                  </td>
                </tr>
              <% end %>
              <% if @bots.empty? %>
                <tr>
                  <td colspan="5" class="px-5 py-8 text-center text-gray-500">
                    No bots configured yet. <%= link_to 'Create your first bot', new_admin_bot_path, class: 'text-purple-600 hover:text-purple-700 font-medium' %>.
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <!-- Tokens Panel -->
    <div data-tabs-target="panel" data-tabs-id="tokens" class="hidden w-full space-y-6">
      <section class="rounded-xl border border-blue-100 bg-blue-50/70 p-6 shadow-sm" id="create-token">
        <h2 class="text-lg font-semibold text-blue-900">Generate API token</h2>
        <p class="mt-1 text-sm text-blue-700">Tokens authenticate Home Assistant and other automation clients. Configure scopes to limit access.</p>
        <%= form_with model: [@new_token], url: admin_tokens_path, method: :post, data: { turbo_frame: "token_modal" }, class: "mt-4 space-y-4" do |f| %>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <!-- Token name -->
            <div>
              <%= f.label :name, 'Token name', class: "block text-sm font-medium text-blue-900" %>
              <%= f.text_field :name, placeholder: "Home Assistant", class: "mt-1 block w-full rounded-md border-blue-200 bg-white px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-blue-500", required: true %>
            </div>

            <!-- Token type -->
            <div>
              <%= f.label :token_type, 'Token type', class: "block text-sm font-medium text-blue-900" %>
              <%= f.select :token_type, [['Standard', 'user'], ['Admin', 'admin'], ['Bot/Integration', 'bot']], {}, class: "mt-1 block w-full rounded-md border-blue-200 bg-white px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
            </div>

            <!-- Expiration -->
            <div>
              <%= f.label :expires_at, 'Expires (optional)', class: "block text-sm font-medium text-blue-900" %>
              <%= f.datetime_local_field :expires_at, class: "mt-1 block w-full rounded-md border-blue-200 bg-white px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
            </div>
          </div>

          <!-- Scope selection -->
          <fieldset class="border border-blue-200 rounded-lg p-4 bg-white">
            <legend class="text-sm font-medium text-blue-900 px-2">Permissions (leave empty for full access)</legend>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 mt-2">
              <!-- User scopes -->
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase mb-2">User Access</p>
                <label class="flex items-center gap-2 text-sm">
                  <%= check_box_tag 'api_token[scopes][]', 'user:profile', false, class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
                  Profile access
                </label>
                <label class="flex items-center gap-2 text-sm mt-1">
                  <%= check_box_tag 'api_token[scopes][]', 'user:channels', false, class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
                  Channel list
                </label>
                <label class="flex items-center gap-2 text-sm mt-1">
                  <%= check_box_tag 'api_token[scopes][]', 'user:messages', false, class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
                  Read/write messages
                </label>
              </div>

              <!-- Channel scopes -->
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase mb-2">Channel Access</p>
                <label class="flex items-center gap-2 text-sm">
                  <%= check_box_tag 'api_token[scopes][]', 'channel:*:read', false, class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
                  Read all channels
                </label>
                <label class="flex items-center gap-2 text-sm mt-1">
                  <%= check_box_tag 'api_token[scopes][]', 'channel:*:write', false, class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
                  Write to all channels
                </label>
                <label class="flex items-center gap-2 text-sm mt-1">
                  <%= check_box_tag 'api_token[scopes][]', 'bot:post', false, class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
                  Bot: post only
                </label>
              </div>

              <!-- Admin scopes -->
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase mb-2">Admin Access</p>
                <label class="flex items-center gap-2 text-sm">
                  <%= check_box_tag 'api_token[scopes][]', 'admin:*', false, class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
                  Full admin
                </label>
                <label class="flex items-center gap-2 text-sm mt-1">
                  <%= check_box_tag 'api_token[scopes][]', 'admin:users', false, class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
                  Manage users
                </label>
                <label class="flex items-center gap-2 text-sm mt-1">
                  <%= check_box_tag 'api_token[scopes][]', 'admin:tokens', false, class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
                  Manage tokens
                </label>
              </div>
            </div>
          </fieldset>

          <div class="flex justify-end">
            <button type="submit" class="inline-flex items-center justify-center rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-blue-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500">Create token</button>
          </div>
        <% end %>
      </section>

      <section class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden">
        <header class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-900">Active tokens</h2>
          <span class="text-sm text-gray-500"><%= @tokens.size %> total</span>
        </header>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50 text-xs uppercase text-gray-500">
              <tr>
                <th class="px-5 py-3 text-left">Name</th>
                <th class="px-5 py-3 text-left">Type</th>
                <th class="px-5 py-3 text-left">Scopes</th>
                <th class="px-5 py-3 text-left">Expires</th>
                <th class="px-5 py-3 text-left">Status</th>
                <th class="px-5 py-3 text-left">Last used</th>
                <th class="px-5 py-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 text-sm text-gray-700">
              <% @tokens.each do |t| %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-5 py-3 font-medium text-gray-900">
                    <%= t.name %>
                    <span class="block text-xs text-gray-400 font-mono"><%= t.short_token || '—' %></span>
                  </td>
                  <td class="px-5 py-3">
                    <% type_colors = { 'user' => 'bg-gray-100 text-gray-700', 'admin' => 'bg-purple-100 text-purple-700', 'bot' => 'bg-blue-100 text-blue-700' } %>
                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= type_colors[t.effective_token_type] %>">
                      <%= t.effective_token_type %>
                    </span>
                  </td>
                  <td class="px-5 py-3 max-w-xs">
                    <% if t.legacy_full_access? %>
                      <span class="text-amber-600 text-xs">Full access (legacy)</span>
                    <% else %>
                      <span class="text-xs text-gray-600">
                        <%= t.scopes.take(3).join(', ') %>
                        <% if t.scopes.size > 3 %>
                          <span class="text-gray-400">+<%= t.scopes.size - 3 %> more</span>
                        <% end %>
                      </span>
                    <% end %>
                  </td>
                  <td class="px-5 py-3 text-xs">
                    <% if t.expires_at %>
                      <% if t.expired? %>
                        <span class="text-red-600">Expired <%= time_ago_in_words(t.expires_at) %> ago</span>
                      <% else %>
                        <span class="text-gray-600"><%= t.expires_at.strftime('%Y-%m-%d') %></span>
                      <% end %>
                    <% else %>
                      <span class="text-gray-400">Never</span>
                    <% end %>
                  </td>
                  <td class="px-5 py-3">
                    <span class="status-dot <%= t.active? && !t.expired? ? 'status-dot--ok' : 'status-dot--warn' %> mr-2"></span>
                    <span><%= t.active? && !t.expired? ? 'Active' : (t.expired? ? 'Expired' : 'Inactive') %></span>
                  </td>
                  <td class="px-5 py-3 text-xs"><%= t.last_used_at&.strftime('%Y-%m-%d %H:%M') || '—' %></td>
                  <td class="px-5 py-3">
                    <div class="flex flex-wrap justify-end gap-2">
                      <%= link_to "Edit", edit_admin_token_path(t), class: "inline-flex items-center rounded-md bg-gray-100 px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-200" %>
                      <%= button_to "Regenerate", regenerate_admin_token_path(t), method: :post, data: { turbo_frame: "token_modal" }, class: "inline-flex items-center rounded-md bg-amber-500 px-3 py-1.5 text-xs font-medium text-white hover:bg-amber-600" %>
                      <% if t.active? %>
                        <%= button_to "Deactivate", deactivate_admin_token_path(t), method: :post, class: "inline-flex items-center rounded-md bg-gray-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-gray-700" %>
                      <% else %>
                        <%= button_to "Activate", activate_admin_token_path(t), method: :post, class: "inline-flex items-center rounded-md bg-blue-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-blue-700" %>
                      <% end %>
                      <%= button_to "Delete", admin_token_path(t), method: :delete, data: { turbo_confirm: "Delete token '#{t.name}'?" }, class: "inline-flex items-center rounded-md bg-red-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-red-700" %>
                    </div>
                  </td>
                </tr>
              <% end %>
              <% if @tokens.empty? %>
                <tr>
                  <td colspan="7" class="px-5 py-8 text-center text-gray-500">
                    No tokens yet. Create one above to enable API access.
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</div>

<%= turbo_frame_tag "token_modal" %>
