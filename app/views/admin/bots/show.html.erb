<%= render 'admin/header' %>
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 pb-12">
  <div class="mb-6">
    <%= link_to admin_bots_path, class: "text-blue-600 hover:text-blue-800 flex items-center" do %>
      ← Back to Bots
    <% end %>
  </div>

  <div class="bg-white rounded-lg border border-gray-200 p-6">
    <div class="flex justify-between items-start mb-6">
      <div>
        <h1 class="text-2xl font-semibold text-gray-900"><%= @bot.name %></h1>
        <p class="text-sm text-gray-500 mt-1">Bot Details</p>
      </div>
      <div class="flex items-center space-x-2">
        <% if @bot.active? %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">Active</span>
        <% else %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">Inactive</span>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <h3 class="text-lg font-medium text-gray-900 mb-4">Bot Information</h3>
        <dl class="space-y-3">
          <div>
            <dt class="text-sm font-medium text-gray-500">Name</dt>
            <dd class="text-sm text-gray-900"><%= @bot.name %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Type</dt>
            <dd class="text-sm text-gray-900 capitalize"><%= @bot.bot_type %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Created</dt>
            <dd class="text-sm text-gray-900"><%= @bot.created_at.strftime('%B %d, %Y at %I:%M %p') %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Status</dt>
            <dd class="text-sm text-gray-900">
              <%= @bot.active? ? 'Active' : 'Inactive' %>
            </dd>
          </div>
        </dl>
      </div>

      <% if @bot.webhook? %>
        <div>
          <h3 class="text-lg font-medium text-gray-900 mb-4">Webhook Configuration</h3>
          <dl class="space-y-3">
            <div>
              <dt class="text-sm font-medium text-gray-500">Webhook URL</dt>
              <dd class="text-sm text-gray-900 font-mono bg-gray-50 p-2 rounded">
                <%= @bot.webhook_url(request.base_url) %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Webhook ID</dt>
              <dd class="text-sm text-gray-900 font-mono bg-gray-50 p-2 rounded">
                <%= @bot.webhook_id %>
              </dd>
            </div>
            <% if @bot.webhook_secret.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-500">Webhook Secret</dt>
                <dd class="text-sm text-gray-900">
                  <div class="bg-gray-50 p-2 rounded border">
                    <div class="flex justify-between items-center">
                      <span class="text-gray-500 font-mono text-xs">••••••••••••••••••••</span>
                      <div class="flex gap-2">
                        <button type="button"
                                onclick="copyMaskedSecret()"
                                class="text-xs px-2 py-1 bg-gray-100 text-gray-700 rounded hover:bg-gray-200"
                                title="Copy first 8 characters for verification">
                          Copy Prefix
                        </button>
                        <%= link_to "Regenerate",
                                    regenerate_secret_admin_bot_path(@bot),
                                    class: "text-xs px-2 py-1 bg-yellow-100 text-yellow-800 rounded hover:bg-yellow-200",
                                    data: { turbo_method: :post, turbo_confirm: "This will invalidate the current webhook secret. Continue?" } %>
                      </div>
                    </div>
                  </div>
                  <p class="text-xs text-gray-500 mt-1">
                    Secret is hidden for security. Use "Regenerate" to create a new secret if lost. Use this secret to sign webhook payloads with HMAC-SHA256. Include the signature in the X-Hub-Signature-256 header as "sha256=&lt;signature&gt;".
                  </p>
                </dd>
              </div>
              <%= javascript_tag nonce: true do %>
                function copyMaskedSecret() {
                  // Only show first 8 characters for verification purposes
                  const prefix = '<%= @bot.webhook_secret[0..7] %>';
                  navigator.clipboard.writeText(prefix).then(() => {
                    alert('Secret prefix copied: ' + prefix + '... (first 8 characters only)');
                  }).catch(err => {
                    console.error('Failed to copy:', err);
                  });
                }
              <% end %>
            <% end %>
          </dl>

          <div class="mt-6 pt-4 border-t border-gray-200">
            <h4 class="text-sm font-medium text-gray-900 mb-2">Webhook Usage</h4>
            <div class="bg-gray-50 p-3 rounded text-xs">
              <p class="text-gray-700 mb-2">Send POST requests to the webhook URL with:</p>
              <ul class="text-gray-600 space-y-1 list-disc list-inside">
                <li>Content-Type: application/json</li>
                <li>X-Hub-Signature-256: sha256=&lt;hmac_signature&gt;</li>
                <li>Body: JSON with action, message, room_id, etc.</li>
              </ul>
            </div>
          </div>
        </div>
      <% elsif @bot.ai_bot? %>
        <div>
          <h3 class="text-lg font-medium text-gray-900 mb-4">AI Configuration</h3>
          <dl class="space-y-3">
            <div>
              <dt class="text-sm font-medium text-gray-500">Model</dt>
              <dd class="text-sm text-gray-900 font-mono bg-purple-50 border border-purple-100 p-2 rounded">
                <%= @bot.model.presence || "Server default (#{Setting.fetch(:litellm_default_model, 'not set')})" %>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">Identity</dt>
              <dd class="text-sm text-gray-900">
                Replies are posted as <code class="font-mono"><%= @bot.identity_user&.username || @bot.name %></code>.
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-500">System prompt</dt>
              <dd>
                <pre class="text-sm bg-gray-900 text-gray-100 rounded-lg p-4 overflow-x-auto whitespace-pre-wrap leading-relaxed"><%= @bot.instructions %></pre>
              </dd>
            </div>
          </dl>
          <div class="mt-6 pt-4 border-t border-gray-200 text-xs text-gray-600 space-y-2">
            <p class="font-semibold text-gray-900">How it responds</p>
            <p>The latest channel messages are sent to LiteLLM with the prompt above. The bot joins channels automatically before replying.</p>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-8 pt-6 border-t border-gray-200 flex justify-end space-x-3">
      <% if @bot.ai_bot? %>
        <%= link_to 'Edit', edit_admin_bot_path(@bot), class: 'px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50' %>
      <% end %>
      <% if @bot.webhook? && @bot.webhook_secret.present? %>
        <%= button_to "Regenerate Secret", regenerate_secret_admin_bot_path(@bot),
                      method: :post,
                      data: { turbo_confirm: "This will invalidate the current secret. Continue?" },
                      class: "px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" %>
      <% end %>

      <% if @bot.active? %>
        <%= button_to "Deactivate", deactivate_admin_bot_path(@bot),
                      method: :post,
                      class: "px-4 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-yellow-600 hover:bg-yellow-700" %>
      <% else %>
        <%= button_to "Activate", activate_admin_bot_path(@bot),
                      method: :post,
                      class: "px-4 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-green-600 hover:bg-green-700" %>
      <% end %>

      <%= button_to "Delete", admin_bot_path(@bot),
                    method: :delete,
                    data: { turbo_confirm: "Delete bot #{@bot.name}? This cannot be undone." },
                    class: "px-4 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-red-600 hover:bg-red-700" %>
    </div>
  </div>
</div>

