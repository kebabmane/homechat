<%= render 'admin/header' %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 pb-12 space-y-6">
  <div>
    <%= link_to admin_bots_path, class: 'text-sm text-purple-600 hover:text-purple-700 font-medium' do %>
      ← Back to bots
    <% end %>
  </div>
  <header class="space-y-2">
    <h1 class="text-2xl font-semibold text-gray-900">Create AI bot</h1>
    <p class="text-sm text-gray-600">Configure a prompt-driven assistant powered by LiteLLM. You can invite it into channels or start direct conversations.</p>
  </header>
  <section class="rounded-xl border border-gray-200 bg-white shadow-sm p-6">
    <%= render 'form' %>
  </section>
</div>
