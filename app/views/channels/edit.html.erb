<% content_for :no_top_padding, true %>

<div class="min-h-full px-3 py-4 sm:px-6 sm:py-8">
  <div class="mx-auto w-full max-w-3xl space-y-5">
    <section class="overflow-hidden rounded-2xl border border-stone-200 bg-white/90 shadow-sm">
      <div class="border-b border-stone-200/80 px-4 py-4 sm:px-6 sm:py-5">
        <div class="flex items-start gap-3 sm:items-center sm:gap-4">
          <span class="inline-flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-amber-100 text-amber-700">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
            </svg>
          </span>
          <div class="min-w-0">
            <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-stone-900">Edit Channel</h1>
            <p class="mt-1 text-sm text-stone-600">Update channel details and visibility settings.</p>
          </div>
        </div>
      </div>

      <%= form_with model: @channel, local: true, class: "space-y-6 p-4 sm:p-6" do |form| %>
        <%= render 'shared/form_errors', model: @channel %>

        <div class="space-y-5">
          <div>
            <%= form.label :name, class: "mb-2 block text-sm font-medium text-stone-900" do %>
              Channel Name
            <% end %>
            <div class="relative">
              <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-stone-400" aria-hidden="true">#</span>
              <%= form.text_field :name,
                  class: "h-11 w-full rounded-lg border #{@channel.errors.include?(:name) ? 'border-rose-400 bg-rose-50/30' : 'border-stone-300 bg-stone-50'} pl-8 pr-3 text-sm text-stone-900 placeholder-stone-400 outline-none transition focus:border-amber-500 focus:bg-white focus:ring-2 focus:ring-amber-500/20",
                  placeholder: "general, random, announcements...",
                  data: { controller: "focus" } %>
            </div>
          </div>

          <div>
            <%= form.label :description, class: "mb-2 block text-sm font-medium text-stone-900" do %>
              Description <span class="font-normal text-stone-400">(optional)</span>
            <% end %>
            <%= form.text_area :description,
                rows: 4,
                class: "w-full rounded-lg border border-stone-300 bg-stone-50 px-3 py-2.5 text-sm text-stone-900 placeholder-stone-400 outline-none transition focus:border-amber-500 focus:bg-white focus:ring-2 focus:ring-amber-500/20",
                placeholder: "What's this channel about?" %>
          </div>

          <div>
            <%= form.label :channel_type, class: "mb-3 block text-sm font-medium text-stone-900" do %>
              Channel Privacy
            <% end %>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <label class="block cursor-pointer">
                <%= form.radio_button :channel_type, "public", class: "peer sr-only" %>
                <div class="rounded-xl border border-stone-300 bg-stone-50 p-4 transition peer-checked:border-emerald-500 peer-checked:bg-emerald-50/70">
                  <div class="flex items-center gap-3">
                    <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100 text-emerald-700">
                      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM4.332 8.027a6.012 6.012 0 011.912-2.706C6.512 5.73 6.974 6 7.5 6A1.5 1.5 0 019 7.5V8a2 2 0 004 0 2 2 0 011.523-1.943A5.977 5.977 0 0116 10c0 .34-.028.675-.083 1H15a2 2 0 00-2 2v2.197A5.973 5.973 0 0110 16v-2a2 2 0 00-2-2 2 2 0 01-2-2 2 2 0 00-1.668-1.973z" clip-rule="evenodd"></path>
                      </svg>
                    </span>
                    <span class="text-sm font-semibold text-stone-900">Public</span>
                  </div>
                  <p class="mt-2 text-sm text-stone-600">Visible to everyone. Anyone can join.</p>
                </div>
              </label>

              <label class="block cursor-pointer">
                <%= form.radio_button :channel_type, "private", class: "peer sr-only" %>
                <div class="rounded-xl border border-stone-300 bg-stone-50 p-4 transition peer-checked:border-amber-500 peer-checked:bg-amber-50/70">
                  <div class="flex items-center gap-3">
                    <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-amber-100 text-amber-700">
                      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path>
                      </svg>
                    </span>
                    <span class="text-sm font-semibold text-stone-900">Private</span>
                  </div>
                  <p class="mt-2 text-sm text-stone-600">Invite-only access. Great for focused work.</p>
                  <div class="mt-2 text-xs text-emerald-700">
                    <%= e2ee_inline(text: 'E2EE required', class_name: 'inline-flex items-center gap-1 text-emerald-700') %>
                  </div>
                </div>
              </label>
            </div>
          </div>
        </div>

        <div class="flex flex-col-reverse gap-3 border-t border-stone-200 pt-5 sm:flex-row sm:items-center sm:justify-between">
          <%= link_to channel_path(@channel),
              class: "inline-flex min-h-11 items-center justify-center rounded-lg border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 transition hover:bg-stone-50" do %>
            Cancel
          <% end %>

          <%= form.submit "Save Changes", class: "btn-press inline-flex min-h-11 items-center justify-center rounded-lg bg-stone-900 px-5 py-2 text-sm font-semibold text-white transition hover:bg-stone-800" %>
        </div>
      <% end %>
    </section>

    <% if @channel.private? %>
      <section class="rounded-2xl border border-stone-200 bg-white/90 p-4 shadow-sm sm:p-6">
        <div class="mb-4">
          <h2 class="text-base font-semibold text-stone-900">Invite Member</h2>
          <p class="mt-1 text-sm text-stone-600">Add people to this private channel by username.</p>
        </div>

        <%= form_with url: invite_channel_path(@channel), method: :post, local: true, class: "flex flex-col gap-3 sm:flex-row sm:items-center" do |f| %>
          <%= f.text_field :username,
              name: :username,
              placeholder: "username",
              class: "h-11 flex-1 rounded-lg border border-stone-300 bg-stone-50 px-3 text-sm text-stone-900 placeholder-stone-400 outline-none transition focus:border-amber-500 focus:bg-white focus:ring-2 focus:ring-amber-500/20" %>
          <%= f.submit "Invite", class: "inline-flex min-h-11 items-center justify-center rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700" %>
        <% end %>
      </section>
    <% end %>

    <section class="rounded-2xl border border-rose-200 bg-rose-50/60 p-4 shadow-sm sm:p-6">
      <h2 class="text-base font-semibold text-rose-700">Danger Zone</h2>
      <p class="mt-1 text-sm text-rose-700/80">Deleting this channel is permanent and removes message history for everyone.</p>
      <div class="mt-4">
        <%= link_to "Delete Channel",
            channel_path(@channel),
            data: {
              turbo_method: :delete,
              turbo_confirm: "Are you sure you want to delete this channel? This action cannot be undone."
            },
            class: "inline-flex min-h-11 items-center justify-center rounded-lg border border-rose-300 bg-white px-4 py-2 text-sm font-semibold text-rose-700 transition hover:bg-rose-100" %>
      </div>
    </section>
  </div>
</div>
