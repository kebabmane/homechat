<% content_for :no_top_padding, true %>

<div class="min-h-full px-3 py-4 sm:px-6 sm:py-8">
  <div class="mx-auto w-full max-w-6xl space-y-5 sm:space-y-6">
    <section class="rounded-2xl border border-stone-200 bg-white/90 shadow-sm">
      <div class="p-4 sm:p-6">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <div class="min-w-0">
            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-stone-900">Browse Channels</h1>
            <p class="mt-1 text-sm sm:text-base text-stone-600">Discover and join conversations across your workspace.</p>
          </div>

          <%= link_to new_channel_path,
              class: "inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-stone-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-stone-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500" do %>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14M5 12h14" />
            </svg>
            Create Channel
          <% end %>
        </div>

        <div class="mt-4 max-w-xl">
          <label for="channel-search" class="sr-only">Search channels</label>
          <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-stone-400" aria-hidden="true">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </span>
            <input id="channel-search"
                   name="q"
                   type="search"
                   placeholder="Search channels..."
                   value="<%= params[:q] %>"
                   aria-label="Search channels"
                   class="h-11 w-full rounded-lg border border-stone-300 bg-stone-50 pl-10 pr-3 text-sm text-stone-900 placeholder-stone-400 outline-none transition focus:border-amber-500 focus:bg-white focus:ring-2 focus:ring-amber-500/20"
                   data-controller="channel-search <%= 'focus' if params[:focus] == 'search' %>"
                   data-channel-search-target="input"
                   data-action="input->channel-search#filter">
          </div>
        </div>
      </div>
    </section>

    <section class="rounded-2xl border border-stone-200 bg-white/90 shadow-sm">
      <div class="border-b border-stone-200/80 px-4 py-4 sm:px-6 sm:py-5">
        <h2 class="text-lg sm:text-xl font-semibold text-stone-900">Public Channels</h2>
        <p class="mt-1 text-sm text-stone-600">
          Open to everyone · <%= @public_channels.count %> channel<%= "s" unless @public_channels.count == 1 %>
        </p>
      </div>

      <div class="p-4 sm:p-6">
        <% if @public_channels.any? %>
          <div class="grid grid-cols-1 gap-4 lg:grid-cols-2" data-channel-search-target="items">
            <% @public_channels.each do |channel| %>
              <article class="hover-lift flex h-full flex-col rounded-xl border border-stone-200 bg-white p-4 shadow-sm" data-channel-search-target="item" data-name="<%= channel.name %>">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="text-stone-400">#</span>
                      <h3 class="truncate text-lg font-semibold text-stone-900">
                        <%= link_to channel.name, channel_path(channel), class: "hover:text-amber-700 transition-colors" %>
                      </h3>
                      <% if E2eePolicy.required_for_channel?(channel) %>
                        <%= e2ee_inline(text: 'E2EE', class_name: 'inline-flex items-center gap-1 rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700') %>
                      <% end %>
                    </div>
                    <p class="mt-2 text-sm text-stone-600 line-clamp-2">
                      <%= channel.description.presence || "No description yet." %>
                    </p>
                  </div>
                </div>

                <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-stone-500">
                  <span class="inline-flex items-center gap-1">
                    <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                    </svg>
                    Created by <%= channel.creator.username %>
                  </span>
                  <span class="inline-flex items-center gap-1">
                    <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"></path>
                    </svg>
                    <% member_count = @channel_member_counts[channel.id].to_i %>
                    <%= member_count %> member<%= "s" if member_count != 1 %>
                  </span>
                </div>

                <div class="mt-4 flex flex-col gap-3 border-t border-stone-100 pt-4 sm:flex-row sm:items-center sm:justify-between">
                  <span class="text-xs text-stone-500">Created <%= time_ago_in_words(channel.created_at) %> ago</span>
                  <% if @joined_public_channel_ids[channel.id] %>
                    <%= link_to "Enter",
                        channel_path(channel),
                        class: "inline-flex min-h-11 items-center justify-center rounded-lg bg-stone-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-stone-800" %>
                  <% else %>
                    <%= link_to "Join",
                        join_channel_path(channel),
                        data: { turbo_method: :post },
                        class: "inline-flex min-h-11 items-center justify-center rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700" %>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>
        <% else %>
          <div class="rounded-xl border border-dashed border-stone-300 bg-stone-50 px-4 py-10 text-center">
            <h3 class="text-lg font-semibold text-stone-900">No public channels yet</h3>
            <p class="mt-2 text-sm text-stone-600">Create the first shared space for your team.</p>
            <%= link_to "Create First Channel",
                new_channel_path,
                class: "btn-press mt-5 inline-flex min-h-11 items-center justify-center rounded-lg bg-stone-900 px-5 py-2 text-sm font-semibold text-white transition hover:bg-stone-800" %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="rounded-2xl border border-stone-200 bg-white/90 shadow-sm">
      <div class="border-b border-stone-200/80 px-4 py-4 sm:px-6 sm:py-5">
        <h2 class="text-lg sm:text-xl font-semibold text-stone-900">My Channels</h2>
        <p class="mt-1 text-sm text-stone-600">
          Channels you've joined · <%= @my_channels.count %> channel<%= "s" unless @my_channels.count == 1 %>
        </p>
      </div>

      <div class="p-4 sm:p-6">
        <% if @my_channels.any? %>
          <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            <% @my_channels.each do |channel| %>
              <article class="hover-lift flex h-full flex-col rounded-xl border border-stone-200 bg-white p-4 shadow-sm">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="text-stone-400">#</span>
                    <h3 class="truncate text-lg font-semibold text-stone-900">
                      <%= link_to channel.name, channel_path(channel), class: "hover:text-amber-700 transition-colors" %>
                    </h3>
                    <% if E2eePolicy.required_for_channel?(channel) %>
                      <%= e2ee_inline(text: 'E2EE', class_name: 'inline-flex items-center gap-1 rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700') %>
                    <% end %>
                    <% if channel.private? %>
                      <span class="inline-flex items-center gap-1 rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">
                        <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                          <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path>
                        </svg>
                        Private
                      </span>
                    <% end %>
                  </div>

                  <p class="mt-2 text-sm text-stone-600 line-clamp-2">
                    <%= channel.description.presence || "No description yet." %>
                  </p>
                </div>

                <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-stone-500">
                  <span class="inline-flex items-center gap-1">
                    <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                    </svg>
                    <% if channel.creator == current_user %>
                      Created by you
                    <% else %>
                      Created by <%= channel.creator.username %>
                    <% end %>
                  </span>
                  <span class="inline-flex items-center gap-1">
                    <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"></path>
                    </svg>
                    <% member_count = @channel_member_counts[channel.id].to_i %>
                    <%= member_count %> member<%= "s" if member_count != 1 %>
                  </span>
                </div>

                <div class="mt-4 flex flex-col gap-2 border-t border-stone-100 pt-4 sm:flex-row sm:items-center sm:justify-between">
                  <span class="text-xs text-stone-500">
                    <% joined_at = @my_memberships_by_channel_id[channel.id]&.joined_at || channel.created_at %>
                    Joined <%= time_ago_in_words(joined_at) %> ago
                  </span>
                  <div class="flex w-full items-center gap-2 sm:w-auto">
                    <%= link_to "Enter",
                        channel_path(channel),
                        class: "inline-flex min-h-11 flex-1 items-center justify-center rounded-lg bg-stone-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-stone-800 sm:flex-none" %>
                    <%= link_to "Leave",
                        leave_channel_path(channel),
                        data: {
                          turbo_method: :delete,
                          turbo_confirm: "Are you sure you want to leave this channel?"
                        },
                        class: "inline-flex min-h-11 items-center justify-center rounded-lg border border-rose-200 px-3 py-2 text-sm font-medium text-rose-700 transition hover:bg-rose-50" %>
                  </div>
                </div>
              </article>
            <% end %>
          </div>
        <% else %>
          <div class="rounded-xl border border-dashed border-stone-300 bg-stone-50 px-4 py-10 text-center">
            <h3 class="text-lg font-semibold text-stone-900">No joined channels yet</h3>
            <p class="mt-2 text-sm text-stone-600">Join a public channel or create one to get started.</p>
            <div class="mt-5 flex justify-center">
              <%= link_to "Create Channel",
                  new_channel_path,
                  class: "btn-press inline-flex min-h-11 items-center justify-center rounded-lg bg-stone-900 px-5 py-2 text-sm font-semibold text-white transition hover:bg-stone-800" %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  </div>
</div>
