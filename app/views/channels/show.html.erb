<% content_for :no_top_padding, true %>
<% content_for :lock_main_scroll, true %>
<div class="flex flex-col h-full min-h-0"
     data-controller="message-list e2ee"
     data-channel-id="<%= @channel.id %>"
     data-message-list-autoscroll-value="true"
     data-message-list-current-user-value="<%= current_user.username %>"
     data-message-list-channel-type-value="<%= @channel.channel_type %>"
     data-e2ee-channel-id-value="<%= @channel.id %>"
     data-e2ee-channel-type-value="<%= @channel.channel_type %>"
     data-e2ee-current-user-id-value="<%= current_user.id %>">
  <% e2ee_required = E2eePolicy.required_for_channel?(@channel) %>

  <!-- Channel Header -->
  <div class="channel-header" data-message-list-target="header" role="region" aria-label="Channel header">
    <div class="flex items-center gap-2 min-w-0">
      <!-- Mobile: open sidebar -->
      <button type="button"
              class="md:hidden -ml-1 p-2 rounded-lg text-stone-400 hover:bg-stone-100 hover:text-stone-600 transition-colors flex-shrink-0 min-w-11 min-h-11 inline-flex items-center justify-center"
              data-action="click->sidebar#open"
              aria-label="Open sidebar">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <% if @channel.dm? %>
        <% other = @channel.members.where.not(id: current_user.id).first %>
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="flex-shrink-0">
            <%= avatar_for(other, size: 'h-9 w-9') %>
          </div>
          <div class="min-w-0">
            <h1 class="channel-name">@<%= other&.username || @channel.name.sub(/^dm-/, '').gsub('-', ' & ') %></h1>
            <div class="channel-description flex items-center gap-2 flex-wrap">
              <% if other %>
                <% if user_online?(other) %>
                  <span class="inline-flex items-center gap-1 text-green-600">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-500 inline-block" aria-hidden="true"></span>Online
                  </span>
                <% else %>
                  <%= last_seen_text(other) %>
                <% end %>
              <% end %>
              <% if e2ee_required %>
                <%= e2ee_badge(text: 'E2EE required') %>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="min-w-0">
          <h1 class="channel-name"><span class="channel-sigil">#</span><%= @channel.name %></h1>
          <% if @channel.description.present? %>
            <p class="channel-description"><%= @channel.description %></p>
          <% end %>
          <% if e2ee_required %>
            <div class="mt-1">
              <%= e2ee_badge(text: 'E2EE required') %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="flex items-center gap-2 flex-shrink-0">
      <% unless @channel.dm? %>
        <div class="relative" data-controller="channel-members" data-channel-members-url-value="<%= channel_channel_memberships_path(@channel) %>">
          <button type="button"
                  class="channel-member-pill"
                  data-channel-members-target="trigger"
                  data-action="channel-members#toggle"
                  aria-label="View channel members"
                  aria-haspopup="dialog"
                  aria-expanded="false">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3z"/>
            </svg>
            <span id="<%= dom_id(@channel, :member_count) %>"><%= @channel.member_count %></span>
            <span class="hidden sm:inline text-stone-300 mx-0.5">·</span>
            <span class="hidden sm:inline-flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500 inline-block" aria-hidden="true"></span>
              <%= @channel.online_members_count %> online
            </span>
          </button>
          <div class="channel-members-panel hidden fixed inset-x-3 top-[5.25rem] bottom-3 w-auto max-w-none rounded-xl border border-stone-200 bg-white shadow-lg z-40 overflow-hidden sm:absolute sm:inset-x-auto sm:top-full sm:bottom-auto sm:right-0 sm:mt-3 sm:w-72 sm:max-w-sm"
               data-channel-members-target="panel"
               role="dialog"
               aria-modal="true"
               aria-label="Channel members"
               aria-hidden="true"></div>
        </div>
      <% end %>

      <% if (current_user.admin? || @channel.creator == current_user) && !@channel.dm? %>
        <%= link_to edit_channel_path(@channel),
            class: "channel-icon-btn",
            aria: { label: "Edit channel" } do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Messages Area -->
  <div class="message-list-container" data-message-list-target="container">
    <%= turbo_stream_from @channel %>

    <% if @has_unencrypted_visible_messages %>
      <div class="mx-4 mt-3 rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-xs font-medium text-amber-800 sm:mx-6">
        Some visible messages were sent before E2EE enforcement.
      </div>
    <% end %>

    <% if @messages.any? %>
      <div class="pt-6 pb-4" id="<%= dom_id(@channel, :messages) %>" aria-live="polite" aria-label="Chat messages">
        <% divider_rendered = false %>
        <% prev_message = nil %>
        <% @messages.reverse.each do |message| %>
          <% if !divider_rendered && @last_read_at && message.created_at > @last_read_at %>
            <div class="unread-divider" role="separator" aria-label="Unread messages below">
              <span class="unread-divider-label">Unread</span>
            </div>
            <% divider_rendered = true %>
            <% prev_message = nil %>
          <% end %>
          <% grouped = prev_message &&
                       prev_message.user_id == message.user_id &&
                       (message.created_at - prev_message.created_at).abs < 5.minutes %>
          <%= render "messages/message", message: message, grouped: grouped %>
          <% prev_message = message %>
        <% end %>
      </div>
    <% else %>
      <div class="empty-chat-state">
        <div class="empty-chat-icon" aria-hidden="true">
          <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>
        <h2 class="empty-chat-title">Start the conversation</h2>
        <p class="empty-chat-subtitle">
          This is the very beginning of
          <% if @channel.dm? %>
            your direct message history.
          <% else %>
            <strong class="text-stone-800">#<%= @channel.name %></strong>.
          <% end %>
          Say hello!
        </p>
      </div>
    <% end %>

    <div data-message-list-target="typingIndicator"
         class="space-y-3 pb-5"
         role="status"
         aria-live="polite"
         aria-label="Typing indicators"></div>
  </div>

  <!-- Composer -->
  <div class="composer-area" data-message-list-target="composerArea">
    <div data-message-list-target="offlineIndicator"
         class="hidden composer-status-banner"
         role="status"
         aria-live="polite">
      <% if e2ee_required %>
        You are offline. Encrypted messages can be sent when you reconnect.
      <% else %>
        You are offline. Messages will send automatically when you reconnect.
      <% end %>
    </div>

    <% if @channel.private? && (current_user.admin? || @channel.creator == current_user) %>
      <div class="composer-invite-form">
        <%= form_with url: invite_channel_path(@channel), method: :post, local: true do |f| %>
          <%= f.text_field :username, name: :username, placeholder: "Invite by username…",
              class: "composer-invite-input flex-1" %>
          <%= f.submit "Invite", class: "composer-invite-btn" %>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: [ @channel, Message.new ],
        local: true,
        class: "space-y-2",
        data: {
          controller: "mentions upload",
          mentions_users_value: @channel.members.order(:username).pluck(:username).to_json,
          action: "#{e2ee_required ? '' : 'submit->message-list#submitOffline '}submit->e2ee#beforeSubmit submit->message-list#beforeSubmit turbo:submit-end->message-list#afterSubmit"
        } do |form| %>
      <div class="relative">
        <div class="composer-shell">
          <% message_placeholder = @channel.dm? ? "Message @#{@channel.members.where.not(id: current_user.id).first&.username || 'user'}" : "Message ##{@channel.name}" %>
          <%= form.text_area :content,
              placeholder: message_placeholder,
              "aria-label": message_placeholder,
              rows: 1,
              class: "composer-textarea",
              data: {
                message_list_target: "textarea",
                mentions_target: "textarea",
                upload_target: "textarea",
                action: "input->message-list#autoResize input->mentions#onInput keydown.enter->mentions#maybeAccept keydown.enter->message-list#submit keydown.arrow_up->mentions#navigate keydown.arrow_up->message-list#editLastMessage keydown.arrow_down->mentions#navigate keydown.escape->mentions#navigate keydown.escape->message-list#escape"
              } %>

          <% unless @channel.private? || @channel.dm? %>
            <label class="composer-attach-btn" title="Attach files" aria-label="Attach files" style="min-width: 44px; min-height: 44px;">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
              </svg>
              <%= form.file_field :files, multiple: true, class: "hidden", direct_upload: true,
                  "aria-label": "Choose files to attach",
                  data: { upload_target: 'input', action: 'change->upload#change' } %>
            </label>
          <% end %>

          <%= form.hidden_field :content_encoding, value: '', data: { e2ee_target: 'contentEncoding' } %>
          <%= form.hidden_field :encrypted_content, value: '', data: { e2ee_target: 'encryptedContent' } %>
          <%= form.hidden_field :content_hmac, value: '', data: { e2ee_target: 'contentHmac' } %>
          <%= form.hidden_field :sender_device_id, value: '', data: { e2ee_target: 'deviceId' } %>
          <%= form.hidden_field :e2ee_version, value: '', data: { e2ee_target: 'version' } %>
          <%= form.hidden_field :sender_key_fingerprint, value: '', data: { e2ee_target: 'senderKeyFingerprint' } %>

          <%= form.submit "Send",
              class: "composer-send-btn btn-press",
              data: { message_list_target: "sendButton" } %>
        </div>

        <div data-mentions-target="menu"
             class="composer-mentions-menu hidden"></div>
      </div>

      <div data-upload-target="previews" class="pt-2 flex flex-wrap gap-2"></div>

      <div class="composer-helper-row">
        <% if e2ee_required %>
          <%= e2ee_inline(text: 'E2EE required for new messages') %>
          <span class="hidden sm:inline" aria-hidden="true">·</span>
        <% end %>
        <span class="hidden sm:inline">Enter to send</span>
        <span class="hidden sm:inline" aria-hidden="true">·</span>
        <span class="hidden sm:inline">Shift+Enter for a new line</span>
      </div>
    <% end %>
  </div>

  <!-- Scroll to latest -->
  <button type="button"
          class="hidden scroll-latest-btn"
          data-message-list-target="scrollButton"
          data-action="click->message-list#scrollToBottom"
          aria-label="Scroll to newest messages">
    <span class="new-messages-dot" aria-hidden="true"></span>
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
    </svg>
    <span class="hidden sm:inline">Latest</span>
  </button>
</div>
