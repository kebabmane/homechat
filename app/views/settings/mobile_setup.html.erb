<%= content_for :title, 'Mobile Setup' %>

<div class="max-w-2xl mx-auto px-6 lg:px-8 py-8">
  <!-- Back Link -->
  <div class="mb-6">
    <%= link_to edit_settings_path, class: "inline-flex items-center gap-2 text-sm text-gray-600 hover:text-gray-900" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      Back to Settings
    <% end %>
  </div>

  <!-- Main Card -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm">
    <!-- Header -->
    <div class="p-6 border-b border-gray-200">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
        </div>
        <div>
          <h1 class="text-xl font-bold text-gray-900">Connect Mobile App</h1>
          <p class="text-sm text-gray-500">Scan this QR code with the HomeChat mobile app</p>
        </div>
      </div>
    </div>

    <!-- QR Code Section -->
    <div class="p-8 flex flex-col items-center">
      <div class="bg-white p-4 rounded-xl border-2 border-gray-100 shadow-inner">
        <%= @qr_code.as_svg(
          color: "000",
          shape_rendering: "crispEdges",
          module_size: 6,
          standalone: true,
          use_path: true
        ).html_safe %>
      </div>

      <p class="mt-6 text-sm text-gray-500 text-center max-w-sm">
        Open the HomeChat app on your phone and tap "Add Server" then "Scan QR Code"
      </p>
    </div>

    <!-- Server Info -->
    <div class="px-6 pb-6">
      <div class="bg-gray-50 rounded-lg p-4">
        <h3 class="text-sm font-medium text-gray-900 mb-3">Connection Details</h3>
        <dl class="space-y-2 text-sm">
          <div class="flex justify-between">
            <dt class="text-gray-500">Server</dt>
            <dd class="text-gray-900 font-medium"><%= @server_config.server_name %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-gray-500">URL</dt>
            <dd class="text-gray-900 font-mono text-xs"><%= @server_config.base_url %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-gray-500">Mode</dt>
            <dd class="text-gray-900 capitalize"><%= @server_config.mode %></dd>
          </div>
          <% if @server_config.home_assistant_mode? %>
          <div class="flex justify-between">
            <dt class="text-gray-500">Home Assistant</dt>
            <dd class="inline-flex items-center gap-1 text-green-600">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Enabled
            </dd>
          </div>
          <% end %>
        </dl>
      </div>
    </div>

    <!-- Expiration Notice -->
    <div class="px-6 pb-6">
      <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 flex items-start gap-3">
        <svg class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
        <div>
          <p class="text-sm font-medium text-amber-800">This QR code expires in 10 minutes</p>
          <p class="text-sm text-amber-700 mt-1">Refresh this page to generate a new code if needed.</p>
        </div>
      </div>
    </div>

    <!-- Manual Setup Fallback -->
    <div class="px-6 pb-6 border-t border-gray-200 pt-6">
      <details class="group">
        <summary class="flex items-center justify-between cursor-pointer text-sm font-medium text-gray-700 hover:text-gray-900">
          <span>Can't scan the QR code?</span>
          <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </summary>
        <div class="mt-4 space-y-4">
          <div>
            <label class="block text-sm text-gray-600 mb-1">Server URL</label>
            <div class="flex">
              <input type="text" readonly value="<%= @server_config.base_url %>"
                     class="flex-1 rounded-l-lg border-gray-300 bg-gray-50 text-sm font-mono"
                     id="server-url">
              <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('server-url').value)"
                      class="px-3 py-2 bg-gray-100 border border-l-0 border-gray-300 rounded-r-lg text-sm text-gray-600 hover:bg-gray-200">
                Copy
              </button>
            </div>
          </div>
          <div>
            <label class="block text-sm text-gray-600 mb-1">Setup Token</label>
            <div class="flex">
              <input type="text" readonly value="<%= @setup_token %>"
                     class="flex-1 rounded-l-lg border-gray-300 bg-gray-50 text-sm font-mono text-xs"
                     id="setup-token">
              <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('setup-token').value)"
                      class="px-3 py-2 bg-gray-100 border border-l-0 border-gray-300 rounded-r-lg text-sm text-gray-600 hover:bg-gray-200">
                Copy
              </button>
            </div>
          </div>
        </div>
      </details>
    </div>
  </div>
</div>
