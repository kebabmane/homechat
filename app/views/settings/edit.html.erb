<%= content_for :title, 'User Settings' %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Settings</h1>
    <p class="mt-2 text-base text-gray-500">Manage your profile, security, and application preferences.</p>
  </div>

  <%= form_with model: current_user, url: settings_path, method: :patch, local: true,
                data: { controller: "dirty-form" }, class: "contents" do |f| %>
    
    <div data-controller="tabs" data-tabs-active-value="profile" class="flex flex-col md:flex-row gap-8 lg:gap-12">
      <!-- Sidebar Navigation -->
      <nav class="w-full md:w-64 flex-shrink-0" role="tablist" aria-label="Settings sections">
        <div class="space-y-1 sticky top-6">
          <button type="button" id="settings-tab-profile" aria-controls="settings-panel-profile"
                  data-tabs-target="tab" data-tabs-id="profile"
                  data-action="tabs#select"
                  class="w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200 group text-gray-600 hover:bg-gray-50 hover:text-gray-900 aria-selected:bg-blue-50 aria-selected:text-blue-700 aria-selected:shadow-sm">
            <svg class="w-5 h-5 text-gray-400 group-hover:text-gray-500 group-aria-selected:text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            Profile
          </button>
          
          <button type="button" id="settings-tab-security" aria-controls="settings-panel-security"
                  data-tabs-target="tab" data-tabs-id="security"
                  data-action="tabs#select"
                  class="w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200 group text-gray-600 hover:bg-gray-50 hover:text-gray-900 aria-selected:bg-blue-50 aria-selected:text-blue-700 aria-selected:shadow-sm">
            <svg class="w-5 h-5 text-gray-400 group-hover:text-gray-500 group-aria-selected:text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            Security
          </button>

          <button type="button" id="settings-tab-password" aria-controls="settings-panel-password"
                  data-tabs-target="tab" data-tabs-id="password"
                  data-action="tabs#select"
                  class="w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200 group text-gray-600 hover:bg-gray-50 hover:text-gray-900 aria-selected:bg-blue-50 aria-selected:text-blue-700 aria-selected:shadow-sm">
            <svg class="w-5 h-5 text-gray-400 group-hover:text-gray-500 group-aria-selected:text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11.536 11 10 12.536 8.464 11 7 12.536 5.464 11 4 12.536V11H4a2 2 0 01-2-2V5a2 2 0 012-2h4a2 2 0 012 2v2m6 4h4.09A5.923 5.923 0 0020 9v0h0z"></path></svg>
            Password
          </button>

          <button type="button" id="settings-tab-preferences" aria-controls="settings-panel-preferences"
                  data-tabs-target="tab" data-tabs-id="preferences"
                  data-action="tabs#select"
                  class="w-full flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200 group text-gray-600 hover:bg-gray-50 hover:text-gray-900 aria-selected:bg-blue-50 aria-selected:text-blue-700 aria-selected:shadow-sm">
            <svg class="w-5 h-5 text-gray-400 group-hover:text-gray-500 group-aria-selected:text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            Preferences
          </button>
        </div>
      </nav>

      <!-- Main Content Area -->
      <div class="flex-1 min-w-0">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="p-6 sm:p-8 space-y-8">
            
            <!-- Profile Panel -->
            <section id="settings-panel-profile" role="tabpanel" aria-labelledby="settings-tab-profile"
                     data-tabs-target="panel" data-tabs-id="profile" class="space-y-8 animate-in fade-in slide-in-from-bottom-2 duration-300">
              <div class="border-b border-gray-100 pb-5">
                <h2 class="text-xl font-semibold text-gray-900">Public Profile</h2>
                <p class="mt-1 text-sm text-gray-500">This information will be displayed publicly to other members.</p>
              </div>

              <div class="flex flex-col md:flex-row gap-8 items-start">
                <div class="flex-shrink-0 flex flex-col items-center gap-4">
                  <div class="relative group">
                    <%= avatar_for(current_user, size: 'h-32 w-32') %>
                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 rounded-full transition-colors flex items-center justify-center"></div>
                  </div>
                  <% if current_user.avatar.attached? %>
                    <%= link_to "Remove photo", settings_path,
                        data: { turbo_method: :delete, turbo_confirm: "Remove your avatar?" },
                        class: "text-xs font-medium text-red-600 hover:text-red-700 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-full transition-colors" %>
                  <% end %>
                </div>

                <div class="flex-1 w-full space-y-6">
                  <div>
                    <%= f.label :avatar, 'Profile Photo', class: "block text-sm font-medium text-gray-700" %>
                    <div class="mt-2 flex justify-center rounded-lg border border-dashed border-gray-300 px-6 py-8 hover:bg-gray-50 transition-colors cursor-pointer" onclick="document.getElementById('user_avatar').click()">
                      <div class="text-center">
                        <svg class="mx-auto h-12 w-12 text-gray-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path fill-rule="evenodd" d="M1.5 6a2.25 2.25 0 012.25-2.25h16.5A2.25 2.25 0 0122.5 6v12a2.25 2.25 0 01-2.25 2.25H3.75A2.25 2.25 0 011.5 18V6zM3 16.06V18c0 .414.336.75.75.75h16.5A.75.75 0 0021 18v-1.94l-2.69-2.689a1.5 1.5 0 00-2.12 0l-.88.879.97.97a.75.75 0 11-1.06 1.06l-5.16-5.159a1.5 1.5 0 00-2.12 0L3 16.061zm10.125-7.81a1.125 1.125 0 112.25 0 1.125 1.125 0 01-2.25 0z" clip-rule="evenodd" />
                        </svg>
                        <div class="mt-4 flex text-sm leading-6 text-gray-600 justify-center">
                          <span class="relative cursor-pointer rounded-md bg-white font-semibold text-blue-600 focus-within:outline-none focus-within:ring-2 focus-within:ring-blue-600 focus-within:ring-offset-2 hover:text-blue-500">
                            <span>Upload a file</span>
                            <%= f.file_field :avatar, accept: 'image/jpeg,image/jpg,image/png,image/gif,image/webp',
                                class: "sr-only",
                                data: { "avatar-preview-target": "input", action: "change->avatar-preview#preview" } %>
                          </span>
                          <p class="pl-1">or drag and drop</p>
                        </div>
                        <p class="text-xs leading-5 text-gray-500">PNG, JPG, GIF up to 5MB</p>
                      </div>
                    </div>
                    <% if current_user.errors[:avatar].any? %>
                      <p class="mt-2 text-sm text-red-600"><%= current_user.errors[:avatar].first %></p>
                    <% end %>
                  </div>

                  <div>
                    <%= f.label :username, class: "block text-sm font-medium text-gray-700" %>
                    <div class="mt-2 relative rounded-md shadow-sm">
                      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                        <span class="text-gray-500 sm:text-sm">@</span>
                      </div>
                      <%= f.text_field :username, class: "block w-full rounded-lg border-gray-300 pl-8 focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2.5" %>
                    </div>
                  </div>
                </div>
              </div>
            </section>

            <!-- Security Panel -->
            <section id="settings-panel-security" role="tabpanel" aria-labelledby="settings-tab-security"
                     data-tabs-target="panel" data-tabs-id="security" class="space-y-6 hidden animate-in fade-in slide-in-from-bottom-2 duration-300">
              <div class="border-b border-gray-100 pb-5">
                <h2 class="text-xl font-semibold text-gray-900">Security</h2>
                <p class="mt-1 text-sm text-gray-500">Manage your current session and authentication.</p>
              </div>

              <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 flex gap-3">
                 <svg class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                 <div class="text-sm text-amber-800">
                   <strong class="font-medium block mb-1">Password Required</strong>
                   You must enter your current password to make significant changes to your account.
                 </div>
              </div>

              <div>
                <%= f.label :current_password, 'Current password', class: "block text-sm font-medium text-gray-700" %>
                <%= f.password_field :current_password, required: true, autocomplete: "current-password",
                      class: "mt-2 block w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2.5" %>
              </div>
            </section>

            <!-- Password Panel -->
            <section id="settings-panel-password" role="tabpanel" aria-labelledby="settings-tab-password"
                     data-tabs-target="panel" data-tabs-id="password" class="space-y-6 hidden animate-in fade-in slide-in-from-bottom-2 duration-300">
              <div class="border-b border-gray-100 pb-5">
                <h2 class="text-xl font-semibold text-gray-900">Change Password</h2>
                <p class="mt-1 text-sm text-gray-500">Update your password associated with this account.</p>
              </div>

              <div class="grid gap-6">
                <div>
                  <%= f.label :password, 'New password', class: "block text-sm font-medium text-gray-700" %>
                  <%= f.password_field :password, autocomplete: "new-password",
                        class: "mt-2 block w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2.5" %>
                  <p class="mt-2 text-xs text-gray-500">Must be at least 6 characters long.</p>
                </div>

                <div>
                  <%= f.label :password_confirmation, 'Confirm new password', class: "block text-sm font-medium text-gray-700" %>
                  <%= f.password_field :password_confirmation, autocomplete: "new-password",
                        class: "mt-2 block w-full rounded-lg border-gray-300 focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2.5" %>
                </div>
              </div>
            </section>

            <!-- Preferences Panel -->
            <section id="settings-panel-preferences" role="tabpanel" aria-labelledby="settings-tab-preferences"
                     data-tabs-target="panel" data-tabs-id="preferences" class="space-y-6 hidden animate-in fade-in slide-in-from-bottom-2 duration-300" data-controller="preferences">
              <div class="border-b border-gray-100 pb-5">
                <h2 class="text-xl font-semibold text-gray-900">App Preferences</h2>
                <p class="mt-1 text-sm text-gray-500">Customize your chat experience.</p>
              </div>

              <div class="space-y-4">
                <div class="flex items-start">
                  <div class="flex h-6 items-center">
                    <input type="checkbox" id="pref_enter_to_send" data-preferences-target="enter" data-action="change->preferences#save"
                           class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-600">
                  </div>
                  <div class="ml-3 text-sm leading-6">
                    <label for="pref_enter_to_send" class="font-medium text-gray-900 cursor-pointer">Enter to send</label>
                    <p id="pref_enter_to_send_desc" class="text-gray-500">Pressing Enter sends the message. Use Shift+Enter for a new line.</p>
                  </div>
                </div>
              </div>
            </section>
          </div>
          
          <!-- Footer with Submit -->
          <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex items-center justify-end gap-3">
             <button type="button" class="text-sm font-medium text-gray-600 hover:text-gray-900 px-4 py-2 rounded-lg hover:bg-gray-100 transition-colors">Cancel</button>
             <%= f.submit "Save Changes", class: "inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 transition-colors cursor-pointer" %>
          </div>
        </div>
      </div>
    </div>

    <!-- Dirty Form Warning (Toast) -->
    <div data-dirty-form-target="bar" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-50 animate-in slide-in-from-bottom-4 fade-in duration-300">
      <div class="bg-gray-900 text-white px-6 py-3 rounded-full shadow-2xl flex items-center gap-6">
        <span class="text-sm font-medium">You have unsaved changes</span>
        <div class="flex items-center gap-3">
          <button type="button" data-action="dirty-form#reset" class="text-sm text-gray-400 hover:text-white transition-colors">Discard</button>
          <span class="w-px h-4 bg-gray-700"></span>
          <button type="submit" class="text-sm font-semibold text-blue-400 hover:text-blue-300 transition-colors">Save updates</button>
        </div>
      </div>
    </div>
  <% end %>
</div>
