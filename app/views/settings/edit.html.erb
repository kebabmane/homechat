<%= content_for :title, 'User Settings' %>

<div class="max-w-2xl mx-auto px-4 sm:px-6 py-8">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900">Settings</h1>
    <p class="mt-1 text-sm text-gray-500">Manage your profile and preferences.</p>
  </div>

  <%= form_with model: current_user, url: settings_path, method: :patch, local: true, class: "space-y-8" do |f| %>

    <!-- Profile Section -->
    <section class="bg-white rounded-lg border border-gray-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Profile</h2>

      <div class="flex items-start gap-6 mb-6">
        <div class="flex-shrink-0">
          <%= avatar_for(current_user, size: 'h-20 w-20') %>
        </div>
        <div class="flex-1">
          <%= f.label :avatar, 'Profile Photo', class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.file_field :avatar, accept: 'image/jpeg,image/jpg,image/png,image/gif,image/webp',
              class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
          <% if current_user.avatar.attached? %>
            <%= link_to "Remove photo", settings_path,
                data: { turbo_method: :delete, turbo_confirm: "Remove your avatar?" },
                class: "inline-block mt-2 text-xs text-red-600 hover:text-red-700" %>
          <% end %>
        </div>
      </div>

      <div>
        <%= f.label :username, class: "block text-sm font-medium text-gray-700 mb-2" %>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500">@</span>
          <%= f.text_field :username, class: "block w-full rounded-lg border-gray-300 pl-8 py-2 text-sm" %>
        </div>
      </div>
    </section>

    <!-- Password Section -->
    <section class="bg-white rounded-lg border border-gray-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Change Password</h2>
      <p class="text-sm text-gray-500 mb-4">Leave blank to keep your current password.</p>

      <div class="space-y-4">
        <div>
          <%= f.label :current_password, 'Current Password', class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.password_field :current_password, autocomplete: "current-password",
              class: "block w-full rounded-lg border-gray-300 py-2 text-sm" %>
        </div>

        <div>
          <%= f.label :password, 'New Password', class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.password_field :password, autocomplete: "new-password",
              class: "block w-full rounded-lg border-gray-300 py-2 text-sm" %>
          <p class="mt-1 text-xs text-gray-500">Must be at least 6 characters.</p>
        </div>

        <div>
          <%= f.label :password_confirmation, 'Confirm New Password', class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "block w-full rounded-lg border-gray-300 py-2 text-sm" %>
        </div>
      </div>
    </section>

    <!-- Preferences Section -->
    <section class="bg-white rounded-lg border border-gray-200 p-6" data-controller="preferences">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Preferences</h2>

      <label class="flex items-start gap-3 cursor-pointer">
        <input type="checkbox" id="pref_enter_to_send" data-preferences-target="enter" data-action="change->preferences#save"
               class="mt-0.5 h-4 w-4 rounded border-gray-300 text-blue-600">
        <div>
          <span class="text-sm font-medium text-gray-900">Enter to send</span>
          <p class="text-sm text-gray-500">Press Enter to send messages. Use Shift+Enter for new lines.</p>
        </div>
      </label>
    </section>

    <!-- Submit -->
    <div class="flex justify-end">
      <%= f.submit "Save Changes", class: "rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-700 cursor-pointer" %>
    </div>
  <% end %>
</div>
