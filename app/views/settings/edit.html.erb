<%= content_for :title, 'Settings' %>

<div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
  <!-- Profile Card -->
  <div class="bg-white/95 rounded-2xl border border-stone-200 p-5 sm:p-6 mb-6 shadow-sm">
    <div class="flex items-center gap-4 sm:gap-6">
      <div class="flex-shrink-0">
        <%= avatar_for(current_user, size: 'h-20 w-20 text-2xl') %>
      </div>
      <div class="flex-1 min-w-0">
        <h1 class="text-xl sm:text-2xl font-bold text-stone-900 truncate">
          <%= current_user.username %>
        </h1>
        <p class="text-sm text-stone-500 capitalize">
          <%= current_user.role %> · Member since <%= current_user.created_at.strftime("%B %Y") %>
        </p>
      </div>
    </div>
  </div>

  <%= form_with model: current_user, url: settings_path, method: :patch, local: true, html: { class: 'w-full' } do |f| %>
    <!-- Tabs Container -->
    <div data-controller="tabs" data-tabs-active-value="profile" class="w-full">

      <!-- Tab Bar -->
      <div class="w-full flex gap-0 border-b border-stone-200 mb-6 overflow-x-auto pb-1"
           role="tablist"
           aria-label="Settings sections">
        <button type="button" data-tabs-target="tab" data-tabs-id="profile"
                class="settings-tab shrink-0"
                role="tab"
                id="settings-tab-profile"
                aria-controls="settings-panel-profile"
                data-action="click->tabs#select keydown->tabs#onKeydown">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          Profile
        </button>

        <button type="button" data-tabs-target="tab" data-tabs-id="password"
                class="settings-tab shrink-0"
                role="tab"
                id="settings-tab-password"
                aria-controls="settings-panel-password"
                data-action="click->tabs#select keydown->tabs#onKeydown">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
          </svg>
          Password
        </button>

        <button type="button" data-tabs-target="tab" data-tabs-id="preferences"
                class="settings-tab shrink-0"
                role="tab"
                id="settings-tab-preferences"
                aria-controls="settings-panel-preferences"
                data-action="click->tabs#select keydown->tabs#onKeydown">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          Preferences
        </button>

        <button type="button" data-tabs-target="tab" data-tabs-id="security"
                class="settings-tab shrink-0"
                role="tab"
                id="settings-tab-security"
                aria-controls="settings-panel-security"
                data-action="click->tabs#select keydown->tabs#onKeydown">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          Security
        </button>
      </div>

      <!-- Profile Panel -->
      <div data-tabs-target="panel"
           data-tabs-id="profile"
           id="settings-panel-profile"
           role="tabpanel"
           aria-labelledby="settings-tab-profile"
           class="w-full settings-panel">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Avatar Section -->
          <div>
            <h3 class="text-sm font-medium text-gray-900 mb-4">Avatar</h3>
            <div class="flex items-start gap-6">
              <div class="flex-shrink-0">
                <%= avatar_for(current_user, size: 'h-24 w-24 text-xl') %>
              </div>
              <div class="flex-1">
                <%= f.file_field :avatar, accept: 'image/jpeg,image/jpg,image/png,image/gif,image/webp',
                    class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
                <p class="mt-2 text-xs text-gray-500">JPG, PNG, GIF or WebP. Max 5MB.</p>
                <% if current_user.avatar.attached? %>
                  <%= link_to "Remove photo", settings_path,
                      data: { turbo_method: :delete, turbo_confirm: "Remove your avatar?" },
                      class: "inline-block mt-2 text-xs text-red-600 hover:text-red-700" %>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Username Section -->
          <div>
            <h3 class="text-sm font-medium text-gray-900 mb-4">Username</h3>
            <%= f.label :username, class: "block text-sm text-gray-700 mb-2" %>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500">@</span>
              <%= f.text_field :username, class: "block w-full rounded-lg border border-gray-300 pl-8 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" %>
            </div>
            <p class="mt-2 text-xs text-gray-500">This is how others will see you in channels.</p>
          </div>
        </div>
      </div>

      <!-- Password Panel -->
      <div data-tabs-target="panel"
           data-tabs-id="password"
           id="settings-panel-password"
           role="tabpanel"
           aria-labelledby="settings-tab-password"
           class="hidden w-full settings-panel">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div>
            <h3 class="text-sm font-medium text-gray-900 mb-4">Change Password</h3>
            <p class="text-sm text-gray-500 mb-6">Leave fields blank to keep your current password.</p>

            <div class="space-y-4">
              <div>
                <%= f.label :current_password, 'Current Password', class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= f.password_field :current_password, autocomplete: "current-password",
                    class: "block w-full rounded-lg border border-gray-300 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" %>
              </div>

              <div>
                <%= f.label :password, 'New Password', class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= f.password_field :password, autocomplete: "new-password",
                    class: "block w-full rounded-lg border border-gray-300 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" %>
                <p class="mt-1.5 text-xs text-gray-500">Must be at least 6 characters.</p>
              </div>

              <div>
                <%= f.label :password_confirmation, 'Confirm New Password', class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= f.password_field :password_confirmation, autocomplete: "new-password",
                    class: "block w-full rounded-lg border border-gray-300 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" %>
              </div>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-gray-900 mb-4">Password Requirements</h3>
            <ul class="space-y-2 text-sm text-gray-600">
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                Minimum 6 characters
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                Use a mix of letters and numbers
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                Avoid common passwords
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Preferences Panel -->
      <div data-tabs-target="panel"
           data-tabs-id="preferences"
           id="settings-panel-preferences"
           role="tabpanel"
           aria-labelledby="settings-tab-preferences"
           class="hidden w-full settings-panel"
           data-controller="preferences">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Timezone -->
          <div>
            <h3 class="text-sm font-medium text-gray-900 mb-4">Regional Settings</h3>
            <%= f.label :timezone, 'Timezone', class: "block text-sm text-gray-700 mb-2" %>
            <%= f.time_zone_select :timezone, ActiveSupport::TimeZone.all,
                { default: current_user.timezone || 'UTC' },
                class: "block w-full rounded-lg border border-gray-300 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" %>
            <p class="mt-2 text-xs text-gray-500">Message times will be displayed in your selected timezone.</p>
          </div>

          <!-- Behavior -->
          <div>
            <h3 class="text-sm font-medium text-gray-900 mb-4">Behavior</h3>
            <label class="flex items-start gap-3 cursor-pointer p-3 rounded-lg hover:bg-gray-50 transition-colors border border-gray-200">
              <input type="checkbox" id="pref_enter_to_send" data-preferences-target="enter" data-action="change->preferences#save"
                     class="mt-0.5 h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
              <div>
                <span class="text-sm font-medium text-gray-900">Enter to send</span>
                <p class="text-sm text-gray-500">Press Enter to send messages. Use Shift+Enter for new lines.</p>
              </div>
            </label>
          </div>
        </div>
      </div>

      <!-- Security Panel -->
      <div data-tabs-target="panel"
           data-tabs-id="security"
           id="settings-panel-security"
           role="tabpanel"
           aria-labelledby="settings-tab-security"
           class="hidden w-full settings-panel">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- 2FA Section -->
          <div class="p-4 bg-gray-50 rounded-lg border border-gray-200">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-sm font-semibold text-gray-900">Two-Factor Authentication</h3>
                <p class="text-sm text-gray-500 mt-1">Add an extra layer of security to your account using an authenticator app.</p>
                <div class="mt-4">
                  <%= link_to two_factor_settings_path, class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100 transition-colors" do %>
                    Configure 2FA
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <!-- Mobile App Setup -->
          <div class="p-4 bg-gray-50 rounded-lg border border-gray-200">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-sm font-semibold text-gray-900">Mobile App Setup</h3>
                <p class="text-sm text-gray-500 mt-1">Connect your phone to HomeChat by scanning a QR code.</p>
                <div class="mt-4">
                  <%= link_to mobile_setup_settings_path, class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-green-600 bg-green-50 rounded-lg hover:bg-green-100 transition-colors" do %>
                    Setup Mobile App
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Security Tips Row -->
        <div class="mt-6">
          <h3 class="text-sm font-medium text-gray-900 mb-4">Security Tips</h3>
          <ul class="grid grid-cols-1 md:grid-cols-3 gap-3">
            <li class="flex items-start gap-2 p-3 bg-gray-50 rounded-lg">
              <svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <span class="text-sm text-gray-600">Enable 2FA for enhanced account protection</span>
            </li>
            <li class="flex items-start gap-2 p-3 bg-gray-50 rounded-lg">
              <svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <span class="text-sm text-gray-600">Use a unique password for HomeChat</span>
            </li>
            <li class="flex items-start gap-2 p-3 bg-gray-50 rounded-lg">
              <svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <span class="text-sm text-gray-600">Never share your password with others</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Account Info Section -->
    <div class="mt-6 bg-white/85 rounded-2xl border border-stone-200 p-5 sm:p-6">
      <h3 class="text-sm font-semibold text-gray-900 mb-4">Account Information</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="flex items-center justify-between py-2.5 px-3 bg-white rounded-lg border border-gray-200">
          <span class="text-sm text-gray-600">User ID</span>
          <code class="text-sm text-gray-900 font-mono"><%= current_user.id %></code>
        </div>
        <div class="flex items-center justify-between py-2.5 px-3 bg-white rounded-lg border border-gray-200">
          <span class="text-sm text-gray-600">Created</span>
          <span class="text-sm text-gray-900"><%= current_user.created_at.strftime("%b %d, %Y") %></span>
        </div>
        <div class="flex items-center justify-between py-2.5 px-3 bg-white rounded-lg border border-gray-200">
          <span class="text-sm text-gray-600">Role</span>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= current_user.admin? ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-800' %>">
            <%= current_user.role.capitalize %>
          </span>
        </div>
      </div>
    </div>

    <!-- Submit Button -->
    <div class="mt-6 flex justify-end">
      <%= f.submit "Save Changes", class: "inline-flex items-center gap-2 rounded-lg bg-amber-600 px-6 py-2.5 text-sm font-medium text-white hover:bg-amber-700 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 cursor-pointer transition-colors" %>
    </div>
  <% end %>
</div>
