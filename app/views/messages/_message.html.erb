<% grouped ||= false %>
<div class="group message-bubble flex items-end gap-2 px-2 <%= grouped ? 'pt-0.5 pb-0.5' : 'pt-3 pb-1' %>"
     data-message-id="<%= message.id %>"
     data-message-username="<%= message.user.username.downcase %>"
     data-message-user-id="<%= message.user_id %>"
     data-message-content-encoding="<%= message.content_encoding || 'plaintext' %>"
     data-message-encrypted-content="<%= message.encrypted_content.to_s %>"
     data-message-content-hmac="<%= message.content_hmac.to_s %>"
     data-message-sender-device-id="<%= message.try(:sender_device_id).to_s %>"
     data-message-sender-key-fingerprint="<%= message.try(:sender_key_fingerprint).to_s %>"
     data-message-e2ee-version="<%= message.try(:e2ee_version).to_s %>"
     data-message-grouped="<%= grouped %>">

  <% unless grouped %>
    <div class="message-avatar flex-shrink-0 mb-1">
      <%= avatar_for(message.user, size: 'h-6 w-6 sm:h-8 sm:w-8') %>
    </div>
  <% else %>
    <div class="message-avatar-spacer w-6 sm:w-8 flex-shrink-0"></div>
  <% end %>

  <div class="message-content flex flex-col items-start max-w-[85%] sm:max-w-[75%] min-w-0">
    <% unless grouped %>
      <div class="message-header flex items-center gap-2 mb-0.5 ml-1">
        <span class="text-xs font-medium text-gray-600"><%= message.user.username %></span>
      </div>
    <% end %>

    <div class="message-text bg-gray-100 text-gray-900 rounded-2xl <%= grouped ? 'rounded-l-md' : 'rounded-bl-md' %> px-4 py-2.5 shadow-sm text-[15px] leading-relaxed break-words">
      <% if message.e2ee? %>
        <div class="message-body" data-e2ee-body="true">Encrypted message</div>
      <% else %>
        <div class="message-body"><%= render_message_body(message.content).html_safe %></div>
      <% end %>
    </div>

    <div class="message-time flex items-center gap-1 mt-0.5 ml-1">
      <span class="text-[10px] text-gray-400 <%= grouped ? 'opacity-0 group-hover:opacity-100' : 'sm:opacity-0 sm:group-hover:opacity-100' %> transition-opacity" title="<%= message.created_at.strftime('%B %d, %Y at %I:%M %p') %>">
        <%= message.created_at.strftime('%I:%M %p') %>
      </span>
    </div>

    <% if !message.e2ee? && (message.files.attached? || message.content.match?(URI::DEFAULT_PARSER.make_regexp)) %>
      <div class="message-attachments mt-1.5 pl-1">
        <%= render_link_previews(message) %>
        <% if message.files.attached? %>
          <div class="mt-2 flex flex-wrap gap-2">
            <% message.files.each do |file| %>
              <% if file.image? %>
                <%= image_tag file, class: "max-h-64 rounded-xl border border-gray-200 cursor-zoom-in shadow-sm hover:shadow-md transition-shadow", data: { controller: 'lightbox', action: 'click->lightbox#open' } %>
              <% else %>
                <div class="flex items-center gap-2 bg-white border border-gray-200 rounded-lg p-3 shadow-sm hover:border-blue-300 transition-colors">
                  <svg class="w-8 h-8 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                  <div class="text-sm">
                    <%= link_to file.filename, url_for(file), class: "font-medium text-gray-900 hover:text-blue-600 focus:outline-none" %>
                    <div class="text-xs text-gray-500"><%= number_to_human_size(file.byte_size) %></div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
