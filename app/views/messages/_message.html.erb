<% grouped ||= false %>
<%= turbo_frame_tag dom_id(message) do %>
  <div class="message-bubble group msg-row <%= grouped ? '' : 'msg-row-start' %>"
       data-message-id="<%= message.id %>"
       data-message-username="<%= message.user.username.downcase %>"
       data-message-user-id="<%= message.user_id %>"
       data-message-content-encoding="<%= message.content_encoding || 'plaintext' %>"
       data-message-encrypted-content="<%= message.encrypted_content.to_s %>"
       data-message-content-hmac="<%= message.content_hmac.to_s %>"
       data-message-sender-device-id="<%= message.try(:sender_device_id).to_s %>"
       data-message-sender-key-fingerprint="<%= message.try(:sender_key_fingerprint).to_s %>"
       data-message-e2ee-version="<%= message.try(:e2ee_version).to_s %>"
       data-message-grouped="<%= grouped %>">

    <% unless grouped %>
      <div class="msg-avatar">
        <%= avatar_for(message.user, size: 'h-8 w-8') %>
      </div>
    <% else %>
      <div class="msg-avatar-spacer"></div>
    <% end %>

    <div class="msg-body">
      <% unless grouped %>
        <div class="msg-header">
          <span class="msg-username"><%= message.user.username %></span>
          <time class="msg-timestamp"
                datetime="<%= message.created_at.iso8601 %>"
                title="<%= message.created_at.strftime('%B %-d, %Y at %-I:%M %p') %>">
            <%= chat_timestamp(message.created_at) %>
          </time>
        </div>
      <% end %>

      <div class="<%= grouped ? 'msg-row-grouped' : '' %>">
        <div class="msg-bubble">
          <% if message.e2ee? %>
            <div class="message-body" data-e2ee-body="true">
              <span data-e2ee-content="true">Encrypted message</span>
            </div>
          <% else %>
            <div class="message-body"><%= render_message_body(message.content).html_safe %></div>
          <% end %>
        </div>

        <% if grouped %>
          <time class="msg-inline-time"
                datetime="<%= message.created_at.iso8601 %>"
                title="<%= message.created_at.strftime('%B %-d, %Y at %-I:%M %p') %>">
            <%= chat_timestamp(message.created_at) %>
          </time>
        <% end %>
      </div>

      <% if !message.e2ee? && (message.files.attached? || message.content.match?(URI::DEFAULT_PARSER.make_regexp)) %>
        <div class="mt-2 pl-0.5">
          <%= render_link_previews(message) %>
          <% if message.files.attached? %>
            <div class="mt-2 flex flex-wrap gap-2">
              <% message.files.each do |file| %>
                <% if file.image? %>
                  <%= image_tag file,
                      class: "max-h-64 rounded-xl border border-stone-100 cursor-zoom-in shadow-sm hover:shadow-md transition-shadow",
                      data: { controller: 'lightbox', action: 'click->lightbox#open' } %>
                <% else %>
                  <div class="flex items-center gap-2.5 bg-white border border-stone-100 rounded-xl p-3 shadow-sm hover:border-amber-200 hover:shadow-md transition-all">
                    <svg class="w-8 h-8 text-amber-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                    </svg>
                    <div class="text-sm min-w-0">
                      <%= link_to file.filename, url_for(file),
                          class: "font-medium text-stone-800 hover:text-amber-600 focus:outline-none truncate block" %>
                      <div class="text-xs text-stone-400 mt-0.5"><%= number_to_human_size(file.byte_size) %></div>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
