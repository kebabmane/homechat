<div class="min-h-[calc(100vh-8rem)] flex items-center justify-center py-12 px-4">
  <div class="w-full max-w-md">
    <!-- Main Card -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
      <!-- Welcome Header -->
      <div class="p-8 text-center border-b border-gray-100">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-blue-100 flex items-center justify-center">
          <%= image_tag 'logo.svg', alt: '', class: 'h-8 w-8' %>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">
          Welcome to <%= Setting.fetch(:site_name, 'HomeChat') %>
        </h1>
        <p class="mt-2 text-gray-600">
          Your self-hosted chat for home automation
        </p>
      </div>

      <!-- Auth Buttons -->
      <div class="p-6 space-y-3">
        <% if logged_in? %>
          <%= link_to "Go to Chat", dashboard_path, class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition" %>
        <% else %>
          <%= link_to "Sign In", signin_path, class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition" %>
          <%= link_to "Create Account", signup_path, class: "w-full flex justify-center py-3 px-4 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition" %>
        <% end %>
      </div>

      <!-- Divider -->
      <div class="relative px-6">
        <div class="absolute inset-0 flex items-center px-6">
          <div class="w-full border-t border-gray-200"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="px-3 bg-white text-gray-500">or</span>
        </div>
      </div>

      <!-- Mobile App Section -->
      <div class="p-6">
        <h2 class="text-sm font-medium text-gray-900 text-center mb-4">Get the Mobile App</h2>

        <!-- App Store Badges -->
        <div class="flex justify-center gap-3 mb-6">
          <%= link_to docs_path, class: "inline-flex items-center px-4 py-2 rounded-lg bg-gray-900 text-white text-xs font-medium hover:bg-gray-800 transition", aria: { label: "Open iOS setup documentation" } do %>
            <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            App Store
          <% end %>
          <%= link_to docs_path, class: "inline-flex items-center px-4 py-2 rounded-lg bg-gray-900 text-white text-xs font-medium hover:bg-gray-800 transition", aria: { label: "Open Android setup documentation" } do %>
            <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3 20.5v-17c0-.59.34-1.11.84-1.35L13.69 12l-9.85 9.85c-.5-.25-.84-.76-.84-1.35m13.81-5.38L6.05 21.34l8.49-8.49 2.27 2.27m3.35-4.31c.34.27.59.69.59 1.19s-.22.9-.57 1.18l-2.29 1.32-2.5-2.5 2.5-2.5 2.27 1.31M6.05 2.66l10.76 6.22-2.27 2.27-8.49-8.49z"/>
            </svg>
            Play Store
          <% end %>
        </div>

        <!-- QR Code Section -->
        <% if @qr_svg %>
          <div class="text-center">
            <p class="text-xs text-gray-500 mb-3">Already have the app? Scan to connect:</p>
            <div class="inline-block bg-white p-3 rounded-lg border border-gray-200">
              <%= @qr_svg.html_safe %>
            </div>
            <p class="mt-2 text-xs text-gray-400 font-mono break-all"><%= @server_config&.base_url %></p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Docs Link -->
    <div class="mt-6 text-center">
      <p class="text-sm text-gray-600">
        Need help? Check out our <%= link_to "documentation", docs_path, class: "text-blue-600 hover:text-blue-700 font-medium" %>.
      </p>
    </div>
  </div>
</div>
