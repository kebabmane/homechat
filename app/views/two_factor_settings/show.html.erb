<div class="max-w-2xl mx-auto py-8 px-4">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Two-Factor Authentication</h1>

  <% if flash[:notice] %>
    <div class="rounded-md bg-green-50 p-4 mb-6">
      <div class="text-sm text-green-700"><%= flash[:notice] %></div>
    </div>
  <% end %>

  <% if flash[:alert] %>
    <div class="rounded-md bg-red-50 p-4 mb-6">
      <div class="text-sm text-red-700"><%= flash[:alert] %></div>
    </div>
  <% end %>

  <div class="bg-white shadow rounded-lg p-6">
    <% if @two_factor_enabled %>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h3 class="text-lg font-medium text-gray-900">Status</h3>
          <p class="text-sm text-gray-500">Two-factor authentication is enabled for your account.</p>
        </div>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
          Enabled
        </span>
      </div>

      <div class="border-t pt-6 space-y-4">
        <h4 class="text-sm font-medium text-gray-900">Backup Codes</h4>
        <p class="text-sm text-gray-500">
          If you lose access to your authenticator app, you can use backup codes to sign in.
        </p>
        <%= form_with url: regenerate_backup_codes_two_factor_settings_path, method: :post, class: "inline" do |f| %>
          <button type="submit" class="text-sm text-indigo-600 hover:text-indigo-500">
            Generate new backup codes
          </button>
        <% end %>
      </div>

      <div class="border-t pt-6 mt-6">
        <h4 class="text-sm font-medium text-gray-900 mb-4">Disable Two-Factor Authentication</h4>
        <%= form_with url: two_factor_settings_path, method: :delete, class: "space-y-4" do |f| %>
          <div>
            <label for="password" class="block text-sm font-medium text-gray-700">
              Confirm your password
            </label>
            <input type="password" name="password" id="password" required
                   class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
          </div>
          <button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
            Disable Two-Factor Authentication
          </button>
        <% end %>
      </div>
    <% else %>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h3 class="text-lg font-medium text-gray-900">Status</h3>
          <p class="text-sm text-gray-500">Two-factor authentication adds an extra layer of security to your account.</p>
        </div>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
          Disabled
        </span>
      </div>

      <div class="border-t pt-6">
        <%= link_to new_two_factor_settings_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
          Enable Two-Factor Authentication
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="mt-6">
    <%= link_to "Back to Settings", edit_settings_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>
</div>
