<div class="max-w-2xl mx-auto py-8 px-4">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Set Up Two-Factor Authentication</h1>

  <% if flash[:alert] %>
    <div class="rounded-md bg-red-50 p-4 mb-6">
      <div class="text-sm text-red-700"><%= flash[:alert] %></div>
    </div>
  <% end %>

  <div class="bg-white shadow rounded-lg p-6">
    <div class="space-y-6">
      <div>
        <h3 class="text-lg font-medium text-gray-900 mb-2">Step 1: Scan QR Code</h3>
        <p class="text-sm text-gray-500 mb-4">
          Scan this QR code with your authenticator app (Google Authenticator, Authy, 1Password, etc.)
        </p>

        <div class="flex justify-center p-4 bg-white border rounded-lg">
          <% if @qr_code %>
            <%= @qr_code.as_svg(
              offset: 0,
              color: '000',
              shape_rendering: 'crispEdges',
              module_size: 4,
              standalone: true
            ).html_safe %>
          <% end %>
        </div>
      </div>

      <div>
        <h4 class="text-sm font-medium text-gray-900 mb-2">Can't scan the code?</h4>
        <p class="text-sm text-gray-500 mb-2">
          Enter this secret key manually in your authenticator app:
        </p>
        <code class="block p-3 bg-gray-100 rounded-md text-sm font-mono break-all">
          <%= @otp_secret %>
        </code>
      </div>

      <div class="border-t pt-6">
        <h3 class="text-lg font-medium text-gray-900 mb-2">Step 2: Verify Setup</h3>
        <p class="text-sm text-gray-500 mb-4">
          Enter the 6-digit code from your authenticator app and your password to complete setup.
        </p>

        <%= form_with url: two_factor_settings_path, method: :post, class: "space-y-4" do |f| %>
          <div>
            <label for="otp_code" class="block text-sm font-medium text-gray-700">
              Verification Code
            </label>
            <input type="text"
                   name="otp_code"
                   id="otp_code"
                   autocomplete="one-time-code"
                   inputmode="numeric"
                   pattern="[0-9]*"
                   maxlength="6"
                   required
                   class="mt-1 block w-48 px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm text-center text-lg tracking-widest"
                   placeholder="000000">
          </div>

          <div>
            <label for="password" class="block text-sm font-medium text-gray-700">
              Your Password
            </label>
            <input type="password"
                   name="password"
                   id="password"
                   required
                   class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
          </div>

          <div class="flex items-center space-x-4">
            <button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
              Enable Two-Factor Authentication
            </button>
            <%= link_to "Cancel", two_factor_settings_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
