<%
  continue_channel = @recent_messages&.first&.channel || @my_channels.first
  recent_count = @recent_messages&.count || 0
%>

<div class="dashboard-page">
  <div class="dashboard-shell">
    <header class="dashboard-header">
      <div class="dashboard-title-block">
        <p class="dashboard-eyebrow">Welcome back, <%= current_user.username %></p>
        <h1 class="dashboard-title">Dashboard</h1>
      </div>

      <div class="dashboard-stats">
        <span class="dashboard-stat-pill">
          <%= pluralize(@my_channels.count, "channel") %>
        </span>
        <span class="dashboard-stat-pill">
          <%= pluralize(recent_count, "recent message") %>
        </span>
      </div>
    </header>

    <nav class="dashboard-toolbar" aria-label="Dashboard actions">
      <% if continue_channel %>
        <%= link_to channel_path(continue_channel), class: "dashboard-toolbar-link dashboard-toolbar-link--primary" do %>
          <span class="dashboard-toolbar-label">Continue</span>
          <span class="dashboard-toolbar-value">
            <%= continue_channel.dm? ? continue_channel.name.sub(/^dm-/, "@").gsub("-", " & @") : "##{continue_channel.name}" %>
          </span>
        <% end %>
      <% end %>

      <%= link_to "Start DM", new_dm_path, class: "dashboard-toolbar-link" %>
      <%= link_to "Browse channels", channels_path, class: "dashboard-toolbar-link" %>
      <%= link_to "Create channel", new_channel_path, class: "dashboard-toolbar-link" %>
      <%= link_to "Settings", settings_path, class: "dashboard-toolbar-link" %>
      <%= link_to "Mobile setup", mobile_setup_settings_path, class: "dashboard-toolbar-link" %>
    </nav>

    <div class="dashboard-content-grid">
      <section class="dashboard-panel dashboard-panel--full">
        <div class="dashboard-panel-header">
          <div>
            <h2 class="dashboard-panel-title">Recent Activity</h2>
            <p class="dashboard-panel-subtitle">Latest messages you can access</p>
          </div>
          <%= link_to "View channels", channels_path, class: "dashboard-panel-link" %>
        </div>

        <% if @recent_messages&.any? %>
          <div class="dashboard-recent-list">
            <% @recent_messages.first(6).each do |message| %>
              <%= link_to channel_path(message.channel), class: "dashboard-recent-row" do %>
                <div class="dashboard-recent-avatar">
                  <%= avatar_for(message.user, size: "h-9 w-9") %>
                </div>
                <div class="dashboard-recent-body">
                  <div class="dashboard-recent-meta">
                    <span class="dashboard-recent-user"><%= message.user.username %></span>
                    <span class="dashboard-recent-channel"><%= message.channel.dm? ? "direct message" : "##{message.channel.name}" %></span>
                    <time class="dashboard-recent-time" datetime="<%= message.created_at.iso8601 %>">
                      <%= time_ago_in_words(message.created_at) %> ago
                    </time>
                  </div>
                  <p class="dashboard-recent-message">
                    <%= message.e2ee? ? "Encrypted message" : truncate(message.transport_content, length: 120) %>
                  </p>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="dashboard-empty">
            <h3 class="dashboard-empty-title">No messages yet</h3>
            <p class="dashboard-empty-copy">Open a channel or start a direct message to begin.</p>
            <div class="dashboard-empty-actions">
              <%= link_to "Browse channels", channels_path, class: "dashboard-primary-button" %>
              <%= link_to "Start DM", new_dm_path, class: "dashboard-secondary-button" %>
            </div>
          </div>
        <% end %>
      </section>
    </div>
  </div>
</div>
